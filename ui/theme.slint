// Design tokens.

// The fonts named here are bundled with Lilt and registered at start-up (src/fonts.rs).
//
// Every colour, radius, size and duration used by Lilt comes from here. The values that
// differ between appearances are grouped in `AppearanceTokens`; each appearance is one
// value of that struct. Adding an appearance means adding a variant to `Appearance` and
// one more set of tokens; components only ever read `Theme`.

export enum Appearance {
    // The original minimal dark appearance.
    midnight,
    // Dark smoked translucent glass.
    smoked-glass,
    // Clear glass that darkens only as much as the desktop behind it requires.
    liquid-glass,
}

export struct AppearanceTokens {
    // Island material. `surface` is used without a live blur; `blurred-surface` while
    // the system's blurred backdrop is behind the island.
    surface: color,
    surface-hover: color,
    blurred-surface: color,
    blurred-surface-hover: color,
    // Secondary surfaces: tiles, buttons.
    tile: color,
    tile-hover: color,
    control-hover: color,
    control-pressed: color,
    border: color,
    track: color,
    shadow-near: color,
    shadow-far: color,
    // Reflections: a lit rim along the upper edge and a soft sheen from above, and
    // optionally a fainter rim along the lower edge where light leaves the glass.
    reflections: bool,
    rim: color,
    lower-rim: color,
    sheen: color,
    // Text.
    text: color,
    text-secondary: color,
    text-tertiary: color,
    // Content on light fills, such as the play button.
    text-on-light: color,
    // Geometry.
    expanded-radius: length,
    tile-radius: length,
    control-radius: length,
    // Motion, before the reduced-motion factor.
    resize-duration: duration,
    fade-duration: duration,
    hover-duration: duration,
    // Settings window.
    window-background: color,
    blurred-window-background: color,
    sidebar: color,
    blurred-sidebar: color,
    nav-selected: color,
    nav-hover: color,
    nav-text: color,
    window-text: color,
    window-text-secondary: color,
    // Groups of settings rows.
    group-background: color,
    group-border: color,
    group-padding: length,
    group-radius: length,
    // Selectable cards (appearance picker).
    card: color,
    card-hover: color,
    card-border: color,
    // Typography. Body text is DM Sans in every appearance; only headings change.
    // `display-*` is for short, prominent headings ("Tasks", "Settings"); `title-*` for
    // longer headings such as empty-state titles, where a script face would be hard to
    // read. `*-scale` matches each face's apparent size to DM Sans at the same size.
    display-font: string,
    display-weight: int,
    display-scale: float,
    title-font: string,
    title-weight: int,
    title-scale: float,
}

export global Theme {
    // The selected appearance, set by the application.
    in-out property <Appearance> appearance: Appearance.midnight;
    // True while the system's blurred backdrop is behind this window.
    in-out property <bool> live-blur: false;

    out property <AppearanceTokens> midnight: {
        surface: #0a0a0b,
        surface-hover: #111113,
        blurred-surface: #0a0a0b,
        blurred-surface-hover: #111113,
        tile: #ffffff09,
        tile-hover: #ffffff10,
        control-hover: #ffffff14,
        control-pressed: #ffffff0b,
        border: #ffffff12,
        track: #ffffff1c,
        shadow-near: #0000004d,
        shadow-far: #00000024,
        reflections: false,
        rim: #ffffff30,
        lower-rim: #ffffff14,
        sheen: #ffffff10,
        text: #f3f3f5,
        text-secondary: #a0a0a8,
        text-tertiary: #6c6c75,
        text-on-light: #0a0a0b,
        expanded-radius: 28px,
        tile-radius: 16px,
        control-radius: 9px,
        resize-duration: 420ms,
        fade-duration: 180ms,
        hover-duration: 140ms,
        window-background: #151517,
        blurred-window-background: #151517,
        sidebar: #111113,
        blurred-sidebar: #111113,
        nav-selected: #ffffff14,
        nav-hover: #ffffff0a,
        nav-text: #b4b4bc,
        window-text: #f3f3f5,
        window-text-secondary: #9a9aa2,
        group-background: transparent,
        group-border: transparent,
        group-padding: 0px,
        group-radius: 0px,
        card: #ffffff07,
        card-hover: #ffffff0d,
        card-border: #ffffff14,
        // Midnight: Space Grotesk, precise and technical.
        display-font: "Space Grotesk",
        display-weight: 600,
        display-scale: 1.0,
        title-font: "Space Grotesk",
        title-weight: 600,
        title-scale: 1.0,
    };

    out property <AppearanceTokens> smoked-glass: {
        // Dense enough to stay legible over any wallpaper without a blur.
        surface: #18181eeb,
        surface-hover: #1e1e25ed,
        // Over the blur the desktop's colour shows through as smoked glass. At the default
        // opacity text keeps at least 4.5:1 contrast even over a white window.
        blurred-surface: #13131a.with-alpha(smoked-alpha),
        blurred-surface-hover: #191921.with-alpha(min(1, smoked-alpha + 0.016)),
        tile: #ffffff0f,
        tile-hover: #ffffff18,
        control-hover: #ffffff1a,
        control-pressed: #ffffff10,
        border: #ffffff1f,
        track: #ffffff26,
        shadow-near: #00000038,
        shadow-far: #0000001a,
        reflections: true,
        rim: #ffffff42,
        lower-rim: #ffffff1c,
        sheen: #ffffff14,
        text: #f6f6f8,
        text-secondary: #b7b7c0,
        text-tertiary: #9595a0,
        text-on-light: #0a0a0b,
        expanded-radius: 30px,
        tile-radius: 18px,
        control-radius: 10px,
        resize-duration: 440ms,
        fade-duration: 190ms,
        hover-duration: 160ms,
        window-background: #17171d,
        blurred-window-background: #121218a6,
        sidebar: #121217,
        blurred-sidebar: #0d0d1270,
        nav-selected: #ffffff1a,
        nav-hover: #ffffff0d,
        nav-text: #c2c2ca,
        window-text: #f6f6f8,
        window-text-secondary: #a9a9b3,
        group-background: #ffffff0a,
        group-border: #ffffff17,
        group-padding: 14px,
        group-radius: 14px,
        card: #ffffff0a,
        card-hover: #ffffff12,
        card-border: #ffffff1a,
        // Smoked Glass: Newsreader italic, an editorial masthead.
        display-font: "Newsreader",
        display-weight: 500,
        display-scale: 1.3,
        title-font: "Newsreader",
        title-weight: 500,
        title-scale: 1.2,
    };

    // How opaque the glass tints are over the live blur, 0..1. The application sets them
    // from the transparency setting and the brightness of the desktop behind the island:
    // as clear as chosen over dark content, and only as dense as text legibility requires
    // over bright content.
    in-out property <float> glass-alpha: 0.5;
    in-out property <float> smoked-alpha: 0.84;

    // The transparency slider, 0 (heaviest blur) .. 1 (clearest), set by the application.
    // The lit edge tracks it: brighter and more defined as the glass clears, softer as it
    // frosts, centred on the as-designed look at 0.5.
    in-out property <float> glass-transparency: 0.5;
    out property <float> rim-strength: clamp(0.4 + glass-transparency * 1.2, 0.4, 1.4);

    out property <AppearanceTokens> liquid-glass: {
        // Without a blur, sharp content would show through, so the frosted surface stays
        // dense; it is cooler and lighter than Smoked Glass.
        surface: #1a1d27eb,
        surface-hover: #20232eed,
        blurred-surface: #10131c.with-alpha(glass-alpha),
        blurred-surface-hover: #10131c.with-alpha(min(1, glass-alpha + 0.04)),
        tile: #ffffff0d,
        tile-hover: #ffffff18,
        control-hover: #ffffff1f,
        control-pressed: #ffffff12,
        border: #ffffff33,
        track: #ffffff2e,
        shadow-near: #00000028,
        shadow-far: #00000010,
        reflections: true,
        rim: #ffffff8c,
        lower-rim: #ffffff36,
        sheen: #ffffff24,
        text: #ffffff,
        text-secondary: #f6f7fb,
        text-tertiary: #d6d9e4,
        text-on-light: #0a0a0b,
        expanded-radius: 32px,
        tile-radius: 19px,
        control-radius: 11px,
        resize-duration: 460ms,
        fade-duration: 200ms,
        hover-duration: 160ms,
        window-background: #1a1d27,
        blurred-window-background: #10131c8c,
        sidebar: #151821,
        blurred-sidebar: #0c0e1559,
        nav-selected: #ffffff1f,
        nav-hover: #ffffff10,
        nav-text: #d2d4dc,
        window-text: #ffffff,
        window-text-secondary: #b9bcc6,
        group-background: #ffffff0d,
        group-border: #ffffff1f,
        group-padding: 14px,
        group-radius: 16px,
        card: #ffffff0d,
        card-hover: #ffffff17,
        card-border: #ffffff21,
        // Liquid Glass: Unbounded, rounded and luminous, for short headings; longer titles
        // stay in DM Sans so a wide face never overflows a narrow panel.
        display-font: "Unbounded",
        display-weight: 500,
        display-scale: 0.95,
        title-font: "DM Sans",
        title-weight: 600,
        title-scale: 1.0,
    };

    out property <AppearanceTokens> tokens: appearance == Appearance.liquid-glass ? liquid-glass
        : appearance == Appearance.smoked-glass ? smoked-glass : midnight;

    // Surfaces
    out property <color> surface: live-blur ? tokens.blurred-surface : tokens.surface;
    out property <color> surface-hover: live-blur ? tokens.blurred-surface-hover : tokens.surface-hover;
    out property <color> tile: tokens.tile;
    out property <color> tile-hover: tokens.tile-hover;
    out property <color> control-hover: tokens.control-hover;
    out property <color> control-pressed: tokens.control-pressed;
    out property <color> border: tokens.border;
    out property <color> track: tokens.track;
    out property <color> shadow-near: tokens.shadow-near;
    out property <color> shadow-far: tokens.shadow-far;
    out property <bool> reflections: tokens.reflections;
    out property <color> rim: tokens.rim;
    out property <color> lower-rim: tokens.lower-rim;
    out property <color> sheen: tokens.sheen;

    // Text
    out property <color> text: tokens.text;
    out property <color> text-secondary: tokens.text-secondary;
    out property <color> text-tertiary: tokens.text-tertiary;
    out property <color> text-on-light: tokens.text-on-light;
    out property <color> live: #6fd39a;

    // Task priorities, used as small marks next to a written label, never alone.
    out property <color> priority-critical: #f07878;
    out property <color> priority-high: #f0a35a;
    out property <color> priority-medium: #e6c766;
    out property <color> priority-low: #79aef0;
    out property <color> danger: #f08a8a;

    // Settings window
    out property <color> window-background: live-blur ? tokens.blurred-window-background : tokens.window-background;
    out property <color> sidebar: live-blur ? tokens.blurred-sidebar : tokens.sidebar;
    out property <color> nav-selected: tokens.nav-selected;
    out property <color> nav-hover: tokens.nav-hover;
    out property <color> nav-text: tokens.nav-text;
    out property <color> window-text: tokens.window-text;
    out property <color> window-text-secondary: tokens.window-text-secondary;
    out property <color> group-background: tokens.group-background;
    out property <color> group-border: tokens.group-border;
    out property <length> group-padding: tokens.group-padding;
    out property <length> group-radius: tokens.group-radius;
    out property <color> card: tokens.card;
    out property <color> card-hover: tokens.card-hover;
    out property <color> card-border: tokens.card-border;

    // Ambient accent, derived from album artwork at runtime.
    in-out property <color> accent: #e8e8ec;
    in-out property <color> wash: #3a3a40;
    in-out property <color> glow: #686870;
    // 0..1, scales every ambient effect. Zero disables them.
    in-out property <float> ambient: 0.6;
    // UI hue gradient, 0..1 (0% to 100%). Stays 0 by default unless tweaked.
    in-out property <float> hue-gradient: 0.0;
    // Active window DPI scale factor, kept in sync by the window host.
    in property <float> scale: 1.0;
    pure callback rounded-border(length, length, length, color, float) -> image;

    // Geometry
    out property <length> compact-height: 38px;
    out property <length> activity-height: 62px;
    out property <length> expanded-radius: tokens.expanded-radius;
    out property <length> tile-radius: tokens.tile-radius;
    out property <length> control-radius: tokens.control-radius;
    out property <length> padding: 14px;
    out property <length> gap: 8px;
    // Room around the island inside the window for the shadow.
    out property <length> margin: 10px;

    // Typography
    // Body and interface text in every appearance.
    out property <string> font: "DM Sans";
    // Code, terminal commands and technical identifiers only.
    out property <string> code-font: "JetBrains Mono";
    out property <string> display-font: tokens.display-font;
    out property <int> display-weight: tokens.display-weight;
    out property <float> display-scale: tokens.display-scale;
    out property <string> title-font: tokens.title-font;
    out property <int> title-weight: tokens.title-weight;
    out property <float> title-scale: tokens.title-scale;
    out property <length> font-xs: 10.5px;
    out property <length> font-sm: 12px;
    out property <length> font-md: 13px;
    out property <length> font-lg: 15px;
    out property <length> font-xl: 24px;

    // Motion. `motion` is 0 when reduced motion is requested.
    in-out property <float> motion: 1;
    out property <duration> resize-duration: tokens.resize-duration * motion;
    out property <duration> fade-duration: tokens.fade-duration * motion;
    out property <duration> hover-duration: tokens.hover-duration * motion;
    out property <duration> ambient-duration: 700ms * motion;
}
