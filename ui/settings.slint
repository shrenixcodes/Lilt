import { Switch, Slider, ComboBox, Button, LineEdit, ScrollView, AboutSlint, Palette } from "std-widgets.slint";
import { Theme, AppearanceTokens } from "theme.slint";
import { Icon, Icons } from "components/icon.slint";
import { GlassSheen, GlassRim } from "components/glass.slint";
import { Heading } from "components/heading.slint";

// Settings as edited in the window. Converted to and from the Rust settings model.

export struct SettingsData {
    // 0 = Midnight, 1 = Smoked Glass, 2 = Liquid Glass
    appearance: int,
    reduce-transparency: bool,
    // 0..100; 50 is each glass appearance as designed.
    glass-transparency: int,
    auto-collapse: bool,
    auto-collapse-seconds: int,
    collapse-on-outside-click: bool,
    activity-banners: bool,
    compact-width: int,
    expanded-width: int,
    // 0 = follow Windows, 1 = reduced, 2 = full
    motion: int,
    // 0 = primary monitor, n = monitors[n - 1]
    monitor: int,
    top-margin: int,
    offset-x: int,
    allow-drag: bool,
    show-media: bool,
    show-calendar: bool,
    show-system: bool,
    show-actions: bool,
    show-tasks: bool,
    tasks-below: bool,
    show-artwork: bool,
    show-progress: bool,
    ambient-enabled: bool,
    ambient-intensity: int,
    low-power: bool,
    hide-in-fullscreen: bool,
    launch-at-startup: bool,
    shortcut: string,
    calendar-path: string,
    show-clipboard: bool,
    clipboard-capture: bool,
    clipboard-skip-secrets: bool,
    clipboard-skip-unknown: bool,
    // 0 = 1 day, 1 = 7 days, 2 = 30 days, 3 = 90 days, 4 = forever
    clipboard-retention: int,
    clipboard-max-items: int,
    clipboard-shortcut: string,
}

// A titled group of rows. Liquid Glass draws each group as a frosted card; Midnight
// keeps plain rows.
component Section inherits VerticalLayout {
    in property <string> title;
    spacing: 2px;
    padding-bottom: 18px;

    Heading {
        text: root.title;
        size: 15px;
        color: Palette.foreground;
        height: 32px;
    }

    Rectangle {
        background: Theme.group-background;
        border-radius: Theme.group-radius;
        border-width: Theme.group-radius > 0 ? 1px : 0px;
        border-color: Theme.group-border;

        VerticalLayout {
            spacing: 2px;
            padding-left: Theme.group-padding;
            padding-right: Theme.group-padding;
            padding-top: Theme.group-padding / 3;
            padding-bottom: Theme.group-padding / 3;

            @children
        }
    }
}

component Row inherits HorizontalLayout {
    in property <string> label;
    in property <string> description;
    spacing: 16px;
    padding-top: 6px;
    padding-bottom: 6px;
    min-height: 44px;

    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        spacing: 2px;

        Text {
            text: root.label;
            color: Palette.foreground;
            font-size: 13px;
            wrap: word-wrap;
        }

        if root.description != "" : Text {
            text: root.description;
            color: Theme.window-text-secondary;
            font-size: 11.5px;
            wrap: word-wrap;
        }
    }

    @children
}

component SliderRow inherits Row {
    in property <int> value;
    in property <int> minimum;
    in property <int> maximum;
    in property <string> unit: "px";
    callback edited(int);

    Slider {
        width: 180px;
        minimum: root.minimum;
        maximum: root.maximum;
        value: root.value;
        changed(v) => { root.edited(round(v)); }
    }

    Text {
        width: 52px;
        vertical-alignment: center;
        horizontal-alignment: right;
        text: root.value + root.unit;
        color: Theme.window-text-secondary;
        font-size: 12px;
    }
}

// A global shortcut with Change and Clear buttons. While recording, the next key
// combination pressed becomes the shortcut.
component ShortcutRow inherits Row {
    in property <string> value;
    in property <string> message;
    in property <bool> recording;
    callback record();
    callback clear();
    callback key(string, bool, bool, bool, bool);

    description: root.recording ? "Press the new shortcut, or Esc to cancel."
        : root.message != "" ? root.message
        : root.value == "" ? "No shortcut assigned." : root.value;

    Button {
        text: root.recording ? "Listening…" : "Change";
        clicked => {
            root.record();
            scope.focus();
        }
    }

    if root.value != "" : Button {
        text: "Clear";
        clicked => { root.clear(); }
    }

    scope := FocusScope {
        width: 0;
        height: 0;
        key-pressed(event) => {
            if !root.recording {
                return reject;
            }
            root.key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
            accept
        }
    }
}

component NavItem inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: 34px;
    border-radius: 6px;
    background: selected ? Theme.nav-selected : touch.has-hover ? Theme.nav-hover : transparent;

    Rectangle {
        x: 0;
        width: 3px;
        height: 16px;
        border-radius: 1.5px;
        background: root.selected ? Theme.window-text : transparent;
    }

    Text {
        x: 14px;
        text: root.text;
        color: root.selected ? Theme.window-text : Theme.nav-text;
        font-size: 13px;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A small desktop showing the compact island and the expanded player, drawn with an
// appearance's own tokens. The wallpaper stands in for the blurred desktop behind glass.
component AppearancePreview inherits Rectangle {
    in property <AppearanceTokens> tokens;
    // Glass shows its translucent surfaces as they appear over the blur.
    in property <bool> glass;
    property <color> panel: root.glass ? root.tokens.blurred-surface : root.tokens.surface;
    property <length> pink-x: root.width * 0.3;
    property <length> amber-x: root.width * 0.74;
    property <length> teal-x: root.width * 0.55;

    border-radius: 8px;
    background: #22305c;

    // Soft colour fields. Each fades out before it reaches a rounded corner.
    Rectangle {
        background: @radial-gradient(circle 46px at root.pink-x 74px, #d6508c 0%, #d6508c00 100%);
    }
    Rectangle {
        background: @radial-gradient(circle 40px at root.amber-x 36px, #f2a33c 0%, #f2a33c00 100%);
    }
    Rectangle {
        background: @radial-gradient(circle 38px at root.teal-x 60px, #3fb4cc 0%, #3fb4cc00 100%);
    }

    pill := Rectangle {
        x: (parent.width - self.width) / 2;
        y: 8px;
        width: 92px;
        height: 20px;
        border-radius: 10px;
        background: root.panel;
        border-width: 1px;
        border-color: root.tokens.border;

        if root.tokens.reflections : GlassSheen {
            width: parent.width;
            height: parent.height;
            radius: parent.border-radius;
            sheen: root.tokens.sheen;
        }

        Text {
            text: "14:05";
            color: root.tokens.text;
            font-size: 9px;
            font-weight: 600;
        }
    }

    if root.tokens.reflections : GlassRim {
        x: pill.x;
        y: pill.y;
        width: pill.width;
        full-height: pill.height;
        radius: pill.border-radius;
        rim: root.tokens.rim;
    }

    panel-rect := Rectangle {
        x: 14px;
        y: 36px;
        width: parent.width - 28px;
        height: parent.height - 46px;
        border-radius: 14px;
        background: root.panel;
        border-width: 1px;
        border-color: root.tokens.border;

        if root.tokens.reflections : GlassSheen {
            width: parent.width;
            height: parent.height;
            radius: parent.border-radius;
            sheen: root.tokens.sheen;
        }

        // Artwork
        Rectangle {
            x: 10px;
            y: (parent.height - self.height) / 2;
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: #4f6fd8;
        }

        // Title, artist and progress
        Rectangle {
            x: 52px;
            y: parent.height / 2 - 13px;
            width: min(70px, parent.width - 120px);
            height: 5px;
            border-radius: 2.5px;
            background: root.tokens.text;
        }
        Rectangle {
            x: 52px;
            y: parent.height / 2 - 3px;
            width: min(46px, parent.width - 120px);
            height: 4px;
            border-radius: 2px;
            background: root.tokens.text-secondary;
        }
        Rectangle {
            x: 52px;
            y: parent.height / 2 + 8px;
            width: parent.width - 120px;
            height: 3px;
            border-radius: 1.5px;
            background: root.tokens.track;

            Rectangle {
                x: 0;
                width: parent.width * 0.4;
                border-radius: 1.5px;
                background: root.tokens.text;
            }
        }

        // A dashboard tile
        Rectangle {
            x: parent.width - 58px;
            y: (parent.height - self.height) / 2;
            width: 48px;
            height: 38px;
            border-radius: 9px;
            background: root.tokens.tile;
        }
    }

    if root.tokens.reflections : GlassRim {
        x: panel-rect.x;
        y: panel-rect.y;
        width: panel-rect.width;
        full-height: panel-rect.height;
        radius: panel-rect.border-radius;
        rim: root.tokens.rim;
    }
}

// One selectable appearance: a preview, its name and a short description.
component AppearanceCard inherits Rectangle {
    in property <string> name;
    in property <string> badge;
    in property <string> description;
    in property <AppearanceTokens> tokens;
    in property <bool> glass;
    in property <bool> selected;
    callback select();

    min-width: 150px;
    horizontal-stretch: 1;
    height: 228px;
    border-radius: 12px;
    background: touch.has-hover ? Theme.card-hover : Theme.card;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.window-text : focus.has-focus ? Theme.window-text-secondary : Theme.card-border;
    animate background, border-color { duration: Theme.hover-duration; }
    accessible-role: button;
    accessible-label: root.name;
    accessible-description: root.description;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => { root.select(); }

    AppearancePreview {
        x: 10px;
        y: 10px;
        width: parent.width - 20px;
        height: 112px;
        tokens: root.tokens;
        glass: root.glass;
    }

    VerticalLayout {
        x: 14px;
        y: 130px;
        width: parent.width - 28px;
        height: parent.height - 138px;
        spacing: 4px;
        alignment: start;

        HorizontalLayout {
            spacing: 8px;
            height: 20px;

            // Each card names its appearance in that appearance's display face.
            Heading {
                horizontal-stretch: 1;
                text: root.name;
                size: 12.5px;
                face: root.tokens.display-font;
                scale: root.tokens.display-scale;
                weight: root.tokens.display-weight;
                color: Theme.window-text;
                overflow: elide;
                min-width: 0;
            }

            // Selection indicator
            Rectangle {
                width: 18px;
                height: 18px;
                y: 1px;
                border-radius: 9px;
                border-width: root.selected ? 0px : 1.5px;
                border-color: Theme.window-text-secondary;
                background: root.selected ? Theme.window-text : transparent;

                if root.selected : Icon {
                    data: Icons.check;
                    size: 12px;
                    color: Theme.text-on-light;
                }
            }
        }

        // A row of its own, kept on every card so the descriptions line up: the name row
        // needs its width for display faces that run wide, such as Allura.
        HorizontalLayout {
            height: 18px;
            alignment: start;

            if root.badge != "" : Rectangle {
                width: badge-text.preferred-width + 12px;
                border-radius: 9px;
                background: Theme.card-border;

                badge-text := Text {
                    text: root.badge;
                    font-size: 10.5px;
                    color: Theme.window-text-secondary;
                }
            }
        }

        Text {
            text: root.description;
            wrap: word-wrap;
            font-size: 11.5px;
            color: Theme.window-text-secondary;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            focus.focus();
            root.select();
        }
    }

    focus := FocusScope {
        width: 0;
        height: 0;
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return {
                root.select();
                return accept;
            }
            reject
        }
    }
}

export component SettingsWindow inherits Window {
    title: "Lilt Settings";
    icon: @image-url("../assets/icons/lilt.png");
    preferred-width: 760px;
    preferred-height: 540px;
    min-width: 620px;
    min-height: 420px;
    background: Theme.window-background;
    default-font-family: Theme.font;

    in-out property <SettingsData> data;
    in property <[string]> monitors: ["Primary display"];
    in property <string> version;
    in property <string> data-folder;
    in property <bool> update-checking;
    in property <bool> update-available;
    in property <string> update-message;
    in property <bool> recording-shortcut;
    // Which shortcut is being recorded: 0 = expand the island, 1 = open the clipboard shelf.
    in property <int> recording-target;
    in property <string> shortcut-message;
    in property <string> clipboard-shortcut-message;
    // Executable names whose copies are never kept.
    in property <[string]> clipboard-excluded;
    // "42 entries · 1.2 MB on disk".
    in property <string> clipboard-usage;
    // 1 or 2 while "Clear history" or "Delete everything" waits for a second click.
    property <int> confirm-clipboard;
    // Why Liquid Glass is not using the live blur, if it is not.
    in property <string> appearance-note;
    in-out property <int> section: 0;

    // Any edit to `data`.
    callback edited();
    callback reset();
    callback choose-calendar();
    callback clear-calendar();
    callback record-shortcut(int);
    callback clear-shortcut(int);
    callback add-excluded-app(string);
    callback remove-excluded-app(int);
    // Clears copied text, or with `true` everything including pinned entries and snippets.
    callback clear-clipboard(bool);
    callback shortcut-key(string, bool, bool, bool, bool);
    callback open-data-folder();
    callback check-for-updates();
    callback open-update();
    callback reset-position();
    // Restores the defaults of the Appearance & position page only.
    callback reset-appearance();

    property <[string]> sections: ["General", "Appearance & position", "Widgets", "Clipboard", "Music", "Ambient visuals", "Performance", "Startup", "Keyboard shortcuts", "About"];

    HorizontalLayout {
        Rectangle {
            width: 200px;
            background: Theme.sidebar;

            VerticalLayout {
                padding: 12px;
                padding-top: 18px;
                spacing: 2px;
                alignment: start;

                Heading {
                    text: "Lilt";
                    size: 20px;
                    color: Theme.window-text;
                    height: 40px;
                }

                for name[i] in root.sections : NavItem {
                    text: name;
                    selected: root.section == i;
                    clicked => { root.section = i; }
                }
            }
        }

        ScrollView {
            horizontal-stretch: 1;

            VerticalLayout {
                padding: 28px;
                padding-top: 24px;
                alignment: start;

                if root.section == 0 : Section {
                    title: "General";
                    Row {
                        label: "Collapse automatically";
                        description: "Return to the compact island after a period without interaction.";
                        Switch {
                            checked: root.data.auto-collapse;
                            toggled => { root.data.auto-collapse = self.checked; root.edited(); }
                        }
                    }
                    if root.data.auto-collapse : SliderRow {
                        label: "Collapse after";
                        value: root.data.auto-collapse-seconds;
                        minimum: 3;
                        maximum: 60;
                        unit: " s";
                        edited(v) => { root.data.auto-collapse-seconds = v; root.edited(); }
                    }
                    Row {
                        label: "Collapse when clicking elsewhere";
                        Switch {
                            checked: root.data.collapse-on-outside-click;
                            toggled => { root.data.collapse-on-outside-click = self.checked; root.edited(); }
                        }
                    }
                    Row {
                        label: "Track change banners";
                        description: "Briefly show the new track in the compact island.";
                        Switch {
                            checked: root.data.activity-banners;
                            toggled => { root.data.activity-banners = self.checked; root.edited(); }
                        }
                    }
                    Row {
                        label: "Reset all settings";
                        description: "Restore the defaults. The calendar file choice and shortcut are reset too.";
                        Button {
                            text: "Reset";
                            clicked => { root.reset(); }
                        }
                    }
                }

                if root.section == 1 : Section {
                    title: "Appearance";
                    HorizontalLayout {
                        spacing: 12px;
                        padding-top: 6px;
                        padding-bottom: 10px;

                        AppearanceCard {
                            name: "Midnight";
                            badge: "Original";
                            description: "Minimal near-black surfaces with quiet borders.";
                            tokens: Theme.midnight;
                            selected: root.data.appearance == 0;
                            select => { root.data.appearance = 0; root.edited(); }
                        }

                        AppearanceCard {
                            name: "Smoked Glass";
                            description: "Dark smoked glass with soft reflections.";
                            tokens: Theme.smoked-glass;
                            glass: true;
                            selected: root.data.appearance == 1;
                            select => { root.data.appearance = 1; root.edited(); }
                        }

                        AppearanceCard {
                            name: "Liquid Glass";
                            badge: "New";
                            description: "Clear glass that darkens only over bright windows.";
                            tokens: Theme.liquid-glass;
                            glass: true;
                            selected: root.data.appearance == 2;
                            select => { root.data.appearance = 2; root.edited(); }
                        }
                    }
                    if root.data.appearance >= 1 && root.appearance-note != "" : Text {
                        text: root.appearance-note;
                        color: Theme.window-text-secondary;
                        font-size: 11.5px;
                        wrap: word-wrap;
                    }
                    if root.data.appearance >= 1 : Row {
                        label: "Reduce transparency";
                        description: "Use frosted surfaces instead of blurring the desktop behind Lilt.";
                        Switch {
                            checked: root.data.reduce-transparency;
                            toggled => { root.data.reduce-transparency = self.checked; root.edited(); }
                        }
                    }
                    if root.data.appearance >= 1 && !root.data.reduce-transparency : SliderRow {
                        label: "Glass transparency";
                        description: "From a heavy blur at 0 % to clear glass at 100 %.";
                        value: root.data.glass-transparency;
                        minimum: 0;
                        maximum: 100;
                        unit: "%";
                        edited(v) => { root.data.glass-transparency = v; root.edited(); }
                    }
                    SliderRow {
                        label: "Compact width";
                        value: root.data.compact-width;
                        minimum: 160;
                        maximum: 300;
                        edited(v) => { root.data.compact-width = v; root.edited(); }
                    }
                    SliderRow {
                        label: "Expanded width";
                        value: root.data.expanded-width;
                        minimum: 400;
                        maximum: 560;
                        edited(v) => { root.data.expanded-width = v; root.edited(); }
                    }
                    Row {
                        label: "Motion";
                        description: "Reduced motion removes size and fade animations.";
                        ComboBox {
                            width: 180px;
                            model: ["Follow Windows", "Reduced", "Full"];
                            current-index: root.data.motion;
                            selected => { root.data.motion = self.current-index; root.edited(); }
                        }
                    }
                }

                if root.section == 1 : Section {
                    title: "Position";
                    Row {
                        label: "Display";
                        ComboBox {
                            width: 220px;
                            model: root.monitors;
                            current-index: root.data.monitor;
                            selected => { root.data.monitor = self.current-index; root.edited(); }
                        }
                    }
                    SliderRow {
                        label: "Distance from top";
                        value: root.data.top-margin;
                        minimum: 0;
                        maximum: 48;
                        edited(v) => { root.data.top-margin = v; root.edited(); }
                    }
                    Row {
                        label: "Allow dragging";
                        description: "Drag the compact island sideways to reposition it.";
                        Switch {
                            checked: root.data.allow-drag;
                            toggled => { root.data.allow-drag = self.checked; root.edited(); }
                        }
                    }
                    Row {
                        label: "Horizontal offset";
                        description: root.data.offset-x == 0 ? "Centred on the display." : root.data.offset-x + " px from the centre.";
                        Button {
                            text: "Centre";
                            enabled: root.data.offset-x != 0;
                            clicked => { root.reset-position(); }
                        }
                    }
                    Row {
                        label: "Reset appearance and position";
                        description: "Midnight, the original sizes and motion setting, the primary display and a centred island.";
                        Button {
                            text: "Reset";
                            clicked => { root.reset-appearance(); }
                        }
                    }
                }

                if root.section == 2 : Section {
                    title: "Widgets";
                    Row {
                        label: "Music player";
                        Switch {
                            checked: root.data.show-media;
                            toggled => { root.data.show-media = self.checked; root.edited(); }
                        }
                    }
                    Row {
                        label: "Calendar";
                        Switch {
                            checked: root.data.show-calendar;
                            toggled => { root.data.show-calendar = self.checked; root.edited(); }
                        }
                    }
                    Row {
                        label: "System monitor";
                        description: "CPU, memory and network readings are only collected while visible.";
                        Switch {
                            checked: root.data.show-system;
                            toggled => { root.data.show-system = self.checked; root.edited(); }
                        }
                    }
                    Row {
                        label: "Quick actions";
                        Switch {
                            checked: root.data.show-actions;
                            toggled => { root.data.show-actions = self.checked; root.edited(); }
                        }
                    }
                    Row {
                        label: "Tasks";
                        description: "A prioritised task list next to the expanded island. Tasks are stored on this PC.";
                        Switch {
                            checked: root.data.show-tasks;
                            toggled => { root.data.show-tasks = self.checked; root.edited(); }
                        }
                    }
                    Row {
                        label: "Clipboard shelf";
                        description: "Copied text and snippets next to the expanded island. See Clipboard for capture and privacy.";
                        Switch {
                            checked: root.data.show-clipboard;
                            toggled => { root.data.show-clipboard = self.checked; root.edited(); }
                        }
                    }
                    if root.data.show-tasks || root.data.show-clipboard : Row {
                        label: "Box layout";
                        description: "Where the Tasks and Clipboard box sits when the island is expanded.";
                        ComboBox {
                            width: 180px;
                            model: ["Beside the island", "Below the island"];
                            current-index: root.data.tasks-below ? 1 : 0;
                            selected => { root.data.tasks-below = self.current-index == 1; root.edited(); }
                        }
                    }
                    Row {
                        label: "Calendar file";
                        description: root.data.calendar-path == "" ? "No .ics file selected." : root.data.calendar-path;
                        Button {
                            text: "Choose…";
                            clicked => { root.choose-calendar(); }
                        }
                        if root.data.calendar-path != "" : Button {
                            text: "Remove";
                            clicked => { root.clear-calendar(); }
                        }
                    }
                }

                if root.section == 3 : Section {
                    title: "Clipboard";
                    Row {
                        label: "Clipboard shelf";
                        description: "Copied text and snippets next to the expanded island. Nothing leaves this PC.";
                        Switch {
                            checked: root.data.show-clipboard;
                            toggled => { root.data.show-clipboard = self.checked; root.edited(); }
                        }
                    }
                    if root.data.show-clipboard : Row {
                        label: "Remember copied text";
                        description: "Off unless you turn it on. Only text is kept, never images or files.";
                        Switch {
                            checked: root.data.clipboard-capture;
                            toggled => { root.data.clipboard-capture = self.checked; root.edited(); }
                        }
                    }
                }

                if root.section == 3 && root.data.show-clipboard : Section {
                    title: "Privacy";
                    Row {
                        label: "Skip likely passwords and keys";
                        description: "Text that looks like a password, private key or access token is not kept. The check is cautious and can miss some, so keep password managers excluded.";
                        Switch {
                            checked: root.data.clipboard-skip-secrets;
                            toggled => { root.data.clipboard-skip-secrets = self.checked; root.edited(); }
                        }
                    }
                    Row {
                        label: "Skip copies from unknown apps";
                        description: "Windows does not always say which app copied something. Turn this on to keep only copies from a known app.";
                        Switch {
                            checked: root.data.clipboard-skip-unknown;
                            toggled => { root.data.clipboard-skip-unknown = self.checked; root.edited(); }
                        }
                    }
                    Row {
                        label: "Excluded apps";
                        description: "Copies from these apps are never kept. Apps that mark their copies as private, as most password managers do, are always skipped too.";
                    }
                    for app[i] in root.clipboard-excluded : Row {
                        label: app;
                        Button {
                            text: "Remove";
                            clicked => { root.remove-excluded-app(i); }
                        }
                    }
                    Row {
                        label: "Exclude another app";
                        description: "The program's file name, for example KeePass.exe.";
                        exclude-input := LineEdit {
                            width: 170px;
                            placeholder-text: "App.exe";
                            accepted(text) => {
                                root.add-excluded-app(text);
                                self.text = "";
                            }
                        }
                        Button {
                            text: "Add";
                            clicked => {
                                root.add-excluded-app(exclude-input.text);
                                exclude-input.text = "";
                            }
                        }
                    }
                }

                if root.section == 3 && root.data.show-clipboard : Section {
                    title: "Storage";
                    Row {
                        label: "Keep copied text for";
                        description: "Pinned entries and snippets are kept until you delete them.";
                        ComboBox {
                            width: 180px;
                            model: ["1 day", "7 days", "30 days", "90 days", "Forever"];
                            current-index: root.data.clipboard-retention;
                            selected => { root.data.clipboard-retention = self.current-index; root.edited(); }
                        }
                    }
                    SliderRow {
                        label: "Most copied entries kept";
                        description: "The oldest copied text is removed first.";
                        value: root.data.clipboard-max-items;
                        minimum: 50;
                        maximum: 5000;
                        unit: "";
                        edited(v) => { root.data.clipboard-max-items = v; root.edited(); }
                    }
                    Row {
                        label: "Clear history";
                        description: root.confirm-clipboard == 1 ? "Delete all copied text? Pinned entries and snippets stay. Click again to confirm."
                            : root.clipboard-usage == "" ? "Copied text, keeping pinned entries and snippets." : root.clipboard-usage;
                        Button {
                            text: root.confirm-clipboard == 1 ? "Clear" : "Clear history";
                            clicked => {
                                if root.confirm-clipboard == 1 {
                                    root.confirm-clipboard = 0;
                                    root.clear-clipboard(false);
                                } else {
                                    root.confirm-clipboard = 1;
                                }
                            }
                        }
                    }
                    Row {
                        label: "Delete everything";
                        description: root.confirm-clipboard == 2 ? "Delete all copied text, pinned entries and snippets? This cannot be undone. Click again to confirm."
                            : "Copied text, pinned entries and snippets.";
                        Button {
                            text: root.confirm-clipboard == 2 ? "Delete" : "Delete everything";
                            clicked => {
                                if root.confirm-clipboard == 2 {
                                    root.confirm-clipboard = 0;
                                    root.clear-clipboard(true);
                                } else {
                                    root.confirm-clipboard = 2;
                                }
                            }
                        }
                    }
                    Text {
                        text: "Deleted text is overwritten in Lilt's database file. Windows may still hold older copies elsewhere, for example in backups or restore points, and SSDs can keep data they have moved.";
                        color: Theme.window-text-secondary;
                        font-size: 11.5px;
                        wrap: word-wrap;
                    }
                    Rectangle { height: 6px; }
                }

                if root.section == 3 && root.data.show-clipboard : Section {
                    title: "Keyboard";
                    ShortcutRow {
                        label: "Open the clipboard shelf";
                        value: root.data.clipboard-shortcut;
                        message: root.clipboard-shortcut-message;
                        recording: root.recording-shortcut && root.recording-target == 1;
                        record => { root.record-shortcut(1); }
                        clear => { root.clear-shortcut(1); }
                        key(text, ctrl, alt, shift, win) => { root.shortcut-key(text, ctrl, alt, shift, win); }
                    }
                    Text {
                        text: "Not set by default: Ctrl+Shift+V, the usual choice, already pastes plain text in browsers and Office and pastes in Windows Terminal. In the shelf, the arrow keys choose an entry, Enter copies it and closes the island, Delete removes it and Ctrl+F searches.";
                        color: Theme.window-text-secondary;
                        font-size: 11.5px;
                        wrap: word-wrap;
                    }
                    Rectangle { height: 6px; }
                }

                if root.section == 4 : Section {
                    title: "Music";
                    Row {
                        label: "Show album artwork";
                        Switch {
                            checked: root.data.show-artwork;
                            toggled => { root.data.show-artwork = self.checked; root.edited(); }
                        }
                    }
                    Row {
                        label: "Show playback progress";
                        description: "Shown when the media application reports a timeline.";
                        Switch {
                            checked: root.data.show-progress;
                            toggled => { root.data.show-progress = self.checked; root.edited(); }
                        }
                    }
                }

                if root.section == 5 : Section {
                    title: "Ambient visuals";
                    Row {
                        label: "Colours from album artwork";
                        description: "Tint the expanded player with a restrained accent taken from the current artwork.";
                        Switch {
                            checked: root.data.ambient-enabled;
                            toggled => { root.data.ambient-enabled = self.checked; root.edited(); }
                        }
                    }
                    if root.data.ambient-enabled : SliderRow {
                        label: "Intensity";
                        value: root.data.ambient-intensity;
                        minimum: 0;
                        maximum: 100;
                        unit: "%";
                        edited(v) => { root.data.ambient-intensity = v; root.edited(); }
                    }
                }

                if root.section == 6 : Section {
                    title: "Performance";
                    Row {
                        label: "Low-power mode";
                        description: "Turns off ambient effects and the glass blur, and samples system readings less often.";
                        Switch {
                            checked: root.data.low-power;
                            toggled => { root.data.low-power = self.checked; root.edited(); }
                        }
                    }
                    Row {
                        label: "Hide during full-screen apps";
                        description: "Keeps games, videos and presentations unobstructed.";
                        Switch {
                            checked: root.data.hide-in-fullscreen;
                            toggled => { root.data.hide-in-fullscreen = self.checked; root.edited(); }
                        }
                    }
                }

                if root.section == 7 : Section {
                    title: "Startup";
                    Row {
                        label: "Start Lilt when you sign in";
                        Switch {
                            checked: root.data.launch-at-startup;
                            toggled => { root.data.launch-at-startup = self.checked; root.edited(); }
                        }
                    }
                }

                if root.section == 8 : Section {
                    title: "Keyboard shortcuts";
                    ShortcutRow {
                        label: "Expand or collapse the island";
                        value: root.data.shortcut;
                        message: root.shortcut-message;
                        recording: root.recording-shortcut && root.recording-target == 0;
                        record => { root.record-shortcut(0); }
                        clear => { root.clear-shortcut(0); }
                        key(text, ctrl, alt, shift, win) => { root.shortcut-key(text, ctrl, alt, shift, win); }
                    }
                    if root.data.show-clipboard : ShortcutRow {
                        label: "Open the clipboard shelf";
                        value: root.data.clipboard-shortcut;
                        message: root.clipboard-shortcut-message;
                        recording: root.recording-shortcut && root.recording-target == 1;
                        record => { root.record-shortcut(1); }
                        clear => { root.clear-shortcut(1); }
                        key(text, ctrl, alt, shift, win) => { root.shortcut-key(text, ctrl, alt, shift, win); }
                    }
                }

                if root.section == 9 : Section {
                    title: "About";
                    Text {
                        text: "Lilt " + root.version;
                        color: Theme.window-text;
                        font-size: 15px;
                        font-weight: 600;
                    }
                    Text {
                        text: "A little more, at a glance.";
                        color: Theme.window-text-secondary;
                        font-size: 12px;
                    }
                    Row {
                        label: "Updates";
                        description: root.update-message;
                        Button {
                            text: root.update-checking ? "Checking…" : "Check for updates";
                            enabled: !root.update-checking;
                            clicked => { root.check-for-updates(); }
                        }
                        if root.update-available : Button {
                            text: "Open update";
                            clicked => { root.open-update(); }
                        }
                    }
                    Row {
                        label: "Settings and logs";
                        description: root.data-folder;
                        Button {
                            text: "Open folder";
                            clicked => { root.open-data-folder(); }
                        }
                    }
                    Text {
                        text: "Lilt keeps your settings on this PC. It checks GitHub for updates and sends no telemetry.";
                        color: Theme.window-text-secondary;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    Rectangle { height: 12px; }
                    AboutSlint {
                        height: 160px;
                    }
                }
            }
        }
    }
}
