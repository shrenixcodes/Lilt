// Data types shared between Rust and the UI.

export enum MediaAvailability {
    // No application currently exposes a media session. Also the state before the
    // first update arrives.
    idle,
    // The Windows media session API could not be used.
    unavailable,
    active,
}

export struct MediaInfo {
    availability: MediaAvailability,
    playing: bool,
    title: string,
    artist: string,
    source: string,
    can-play-pause: bool,
    can-next: bool,
    can-previous: bool,
    can-seek: bool,
    has-timeline: bool,
    session-count: int,
}

export struct SystemInfo {
    ready: bool,
    // 0..1
    cpu: float,
    cpu-text: string,
    // 0..1
    memory: float,
    memory-text: string,
    memory-detail: string,
    down-text: string,
    up-text: string,
}

export enum CalendarState {
    // No calendar file has been chosen.
    not-configured,
    // The chosen file could not be read; see the message.
    unavailable,
    ready,
}

export struct AgendaEntry {
    title: string,
    location: string,
    // "Today", "Tomorrow" or e.g. "Mon 17".
    day: string,
    time: string,
    // The event is in progress.
    now: bool,
}

export enum Page {
    dashboard,
    calendar,
    system,
    // The quick-control pop-ups, opened from the quick actions tile.
    sound,
    brightness,
    bluetooth,
    wifi,
}

// A Wi-Fi network in the Wi-Fi pop-up.
export struct NetworkRow {
    ssid: string,
    // 1 to 4 bars.
    bars: int,
    secured: bool,
    connected: bool,
    // Windows has a saved profile (password) for it.
    saved: bool,
    // Lilt can join it (open, or a personal password); others need Windows' settings.
    joinable: bool,
}

// One application in the volume mixer. `id` is Windows' session instance identifier.
export struct SessionRow {
    id: string,
    name: string,
    icon: image,
    volume: float,
    muted: bool,
    is-system: bool,
}

// A paired Bluetooth device in the Bluetooth pop-up.
export struct DeviceRow {
    name: string,
    address: string,
    connected: bool,
    // Lilt can connect or disconnect it (headphones and speakers).
    can-connect: bool,
}

// Where the tasks box sits next to the expanded island.
export enum TasksLayout {
    beside,
    below,
}

export enum TaskView {
    all,
    today,
    upcoming,
    done,
}

export enum TaskRowKind {
    // "Critical · 2"
    header,
    task,
    // The task to work on next, shown first and larger.
    focus,
}

export struct TaskRow {
    kind: TaskRowKind,
    id: int,
    title: string,
    // Category, source and sync notes, e.g. "Work · Google Tasks".
    meta: string,
    due: string,
    overdue: bool,
    // 0 = none, 1 = low … 4 = critical
    priority: int,
    priority-label: string,
    // Tasks in the group, for headers.
    count: int,
    // From Google: drawn with a source mark.
    imported: bool,
    can-move-up: bool,
    can-move-down: bool,
}

export enum ArchiveRowKind {
    header,
    task,
}

export struct ArchiveRow {
    kind: ArchiveRowKind,
    id: int,
    title: string,
    // "Completed 14:05 · High · was due Fri 13 · Google Tasks"
    detail: string,
    notes: string,
    priority: int,
}

// A task being created or edited.
export struct TaskForm {
    // 0 for a new task.
    id: int,
    title: string,
    notes: string,
    priority: int,
    // Days from today; -10000 for no due date.
    due-offset: int,
    time: string,
    category: string,
    // "Lilt", "Google Tasks · My Tasks", …
    source: string,
    // Explains what synchronises, if anything.
    sync-note: string,
    origin: string,
    // Google Tasks stores dates only.
    time-allowed: bool,
    error: string,
}

export enum SyncStatus {
    // Google is not connected; nothing to show.
    none,
    synced,
    syncing,
    offline,
    failed,
}

// Which panel the box beside (or below) the expanded island shows.
export enum SidePanel {
    tasks,
    clipboard,
}

// The clipboard shelf's list filters.
export enum ClipFilter {
    all,
    pinned,
    recent,
    snippets,
    links,
    code,
    images,
    other,
}

export enum ClipRowKind {
    // A section title such as "Pinned"; `title` holds it.
    header,
    entry,
}

// One line of the clipboard shelf.
export struct ClipRow {
    kind: ClipRowKind,
    id: int,
    // The start of the text, at most two lines are shown.
    preview: string,
    // A snippet's title, or a header's text.
    title: string,
    // App, time and type, e.g. "Microsoft Edge · 5 min ago · Link".
    meta: string,
    // Code, JSON or a command: shown in the code face.
    technical: bool,
    pinned: bool,
    manual: bool,
    count: int,
    has-color: bool,
    color-val: color,
    color-hex: string,
    domain: string,
    has-thumbnail: bool,
    thumbnail: image,
}

// A snippet being edited.
export struct SnippetForm {
    // 0 for a new snippet.
    id: int,
    title: string,
    content: string,
    description: string,
}
