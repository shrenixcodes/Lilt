import { Theme, Appearance } from "../theme.slint";
import { Icon } from "icon.slint";

// A small square icon button with a restrained hover state.
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <length> icon-size: 15px;
    in property <bool> filled: false;
    in property <bool> enabled: true;
    in property <color> tint: Theme.text;
    in property <string> tooltip;
    in property <bool> draggable: false;
    // Exposed so a containing control strip can remain open while its buttons own
    // pointer input.
    out property <bool> hovered: touch.has-hover;
    property <bool> dragged: false;
    callback clicked();
    callback hover-changed(bool);
    callback drag-started();
    changed hovered => { root.hover-changed(root.hovered); }

    width: 30px;
    height: 30px;
    border-radius: Theme.control-radius;
    background: !enabled ? transparent : touch.pressed ? Theme.control-pressed : touch.has-hover ? Theme.control-hover : transparent;
    animate background { duration: Theme.hover-duration; }
    accessible-role: button;
    accessible-label: tooltip;

    Icon {
        data: root.icon;
        size: root.icon-size;
        filled: root.filled;
        color: root.enabled ? root.tint : Theme.text-tertiary;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.dragged = false;
            }
        }
        moved => {
            if root.draggable && self.pressed && !root.dragged
                && (abs(self.mouse-x - self.pressed-x) > 4px || abs(self.mouse-y - self.pressed-y) > 4px) {
                root.dragged = true;
                root.drag-started();
            }
        }
        clicked => {
            if root.dragged {
                root.dragged = false;
            } else {
                root.clicked();
            }
        }
    }
}

// Compact text button for page headers.
export component TextButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: 28px;
    width: label.preferred-width + 22px;
    border-radius: Theme.control-radius;
    background: touch.pressed ? Theme.control-pressed : touch.has-hover ? Theme.control-hover : Theme.tile;
    animate background { duration: Theme.hover-duration; }
    accessible-role: button;
    accessible-label: root.text;

    label := Text {
        text: root.text;
        color: Theme.text;
        font-size: Theme.font-sm;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Thin progress track with an accent fill. Optionally seekable.
export component ProgressBar inherits Rectangle {
    in property <float> value;
    in property <bool> seekable: false;
    in property <color> fill: Theme.accent;
    callback seek(float);
    // Animated locally because globals cannot animate.
    property <color> shown-fill: root.fill;
    animate shown-fill { duration: Theme.ambient-duration; easing: ease-in-out; }
    property <float> shown-value: touch.pressed && root.seekable
        ? clamp(touch.mouse-x / max(1px, root.width), 0, 1) : root.value;

    height: 12px;
    property <length> track-height: (touch.has-hover || touch.pressed) && root.seekable ? 5px : 3px;

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: root.track-height;
        border-radius: self.height / 2;
        background: Theme.track;
        animate height { duration: Theme.hover-duration; }

        Rectangle {
            x: 0;
            width: parent.width * clamp(root.shown-value, 0, 1);
            border-radius: parent.border-radius;
            background: root.shown-fill;
        }
    }

    touch := TouchArea {
        enabled: root.seekable;
        mouse-cursor: root.seekable ? pointer : default;
        property <bool> dragged: false;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                self.dragged = false;
            } else if event.kind == PointerEventKind.up && self.dragged {
                root.seek(clamp(self.mouse-x / max(1px, root.width), 0, 1));
            }
        }
        moved => {
            if self.pressed {
                self.dragged = true;
            }
        }
        clicked => {
            if !self.dragged {
                root.seek(clamp(self.mouse-x / max(1px, root.width), 0, 1));
            }
        }
    }
}

// Horizontal usage meter used by the system monitor.
export component Meter inherits Rectangle {
    in property <float> value;
    height: 4px;
    border-radius: 2px;
    background: Theme.track;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.value, 0, 1);
        border-radius: parent.border-radius;
        background: Theme.accent;
        animate width { duration: Theme.fade-duration * 2; easing: ease-out; }
        animate background { duration: Theme.ambient-duration; easing: ease-in-out; }
    }
}

// Rounded dashboard tile. Clickable when `interactive` is set.
export component Tile inherits Rectangle {
    in property <bool> interactive: false;
    in property <string> label;
    callback clicked();

    border-radius: Theme.tile-radius;
    background: interactive && touch.has-hover ? Theme.tile-hover : Theme.tile;
    animate background { duration: Theme.hover-duration; }
    border-width: Theme.reflections ? 1px : 0px;
    border-color: Theme.appearance == Appearance.liquid-glass ? #ffffff18 : #ffffff0a;
    accessible-role: interactive ? button : groupbox;
    accessible-label: label;

    touch := TouchArea {
        enabled: root.interactive;
        clicked => { root.clicked(); }
    }

    @children
}
