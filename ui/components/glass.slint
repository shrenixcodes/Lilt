import { Theme } from "../theme.slint";

// Light on glass: a soft sheen falling from above and a lit edge along the top and bottom.
//
// The software renderer draws gradients as plain rectangles, ignoring corner radii, and
// clips children only to the bounding box, not the radius. So every glow here is a disc of
// light (a radial gradient) centred just beyond the edge: it is brightest along the edge,
// eases off inward and toward the corners, and fades to nothing before it reaches the
// rounded corner, so the light curves around the corner with no hard line to alias and
// never spills outside the shape. Radial gradients are antialiased, so the edges stay
// smooth at every display scale.

// Place inside a rounded surface, before its content, filling it.
export component GlassSheen inherits Rectangle {
    in property <length> radius;
    in property <color> sheen: Theme.sheen;

    // Horizontal distance from the centre to where the rounded corners begin. Every
    // point of the corner areas is farther than `spread` from the sheen's centre.
    property <length> reach: max(0px, root.width / 2 - root.radius);
    property <length> spread: root.reach * 1.1;
    property <length> lift: root.spread * 0.6;
    property <length> centre-x: root.width / 2;
    property <length> centre-y: 0px - root.lift;

    background: @radial-gradient(circle root.spread at root.centre-x root.centre-y,
        root.sheen 0%, root.sheen 60%, root.sheen.transparentize(0.6) 78%, transparent 100%);
}

// A soft lit edge for glass. Light gathers along the top edge (or the bottom, with `lower`)
// and falls away gently inward and toward the corners, with no hard line. Place it over the
// surface, filling it, with the surface's corner radius.
export component GlassRim inherits Rectangle {
    in property <color> rim: Theme.rim;
    in property <length> radius;
    // The lower edge, lit more faintly from below, rather than the upper edge.
    in property <bool> lower: false;
    // Scales the light with the transparency slider: above 1 brightens it as the glass
    // clears, below 1 softens it as the glass frosts.
    in property <float> strength: 1.0;

    // The rim, its opacity scaled by `strength` so the glow tracks the transparency slider.
    property <color> tint: root.rim.with-alpha(min(1.0, root.rim.alpha * root.strength / 255));

    // A disc of light centred just beyond the edge. `spread` reaches the corners so the
    // edge is lit its whole width; `lift` keeps the centre close enough that the edge sits
    // in the bright part of the disc while the corners fall in its faded tail.
    property <length> reach: max(0px, root.width / 2 - root.radius);
    property <length> spread: root.reach + root.radius * 1.4;
    property <length> lift: root.spread * 0.42;
    property <length> cx: root.width / 2;
    property <length> cy: root.lower ? root.height + root.lift : 0px - root.lift;

    background: @radial-gradient(circle root.spread at root.cx root.cy,
        root.tint 0%, root.tint 44%, root.tint.transparentize(0.58) 66%, transparent 84%);
}
