export component Icon inherits Path {
    in property <string> data;
    in property <color> color: Theme.text;
    in property <length> size: 16px;
    in property <bool> filled: false;
    width: size;
    height: size;
    commands: data;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: filled ? color : transparent;
    stroke: filled ? transparent : color;
    stroke-width: max(1.25px, size * 0.1);
    stroke-line-cap: round;
    stroke-line-join: round;
    animate fill, stroke { duration: Theme.hover-duration; }
}
