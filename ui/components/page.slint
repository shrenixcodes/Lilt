import { Theme } from "../theme.slint";
import { Icons } from "icon.slint";
import { IconButton } from "controls.slint";
import { Heading } from "heading.slint";

// Title row of a detail page, with a back button. Extra controls go on the right.
export component PageHeader inherits HorizontalLayout {
    in property <string> title;
    callback back();
    spacing: 6px;
    height: 30px;

    IconButton {
        icon: Icons.back;
        tooltip: "Back";
        clicked => {
            root.back();
        }
    }

    Heading {
        horizontal-stretch: 1;
        text: root.title;
        color: Theme.text;
        size: Theme.font-lg;
    }

    @children
}
