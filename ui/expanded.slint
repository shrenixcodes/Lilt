import { Theme } from "theme.slint";
import { Page } from "types.slint";
import { AppState } from "state.slint";
import { MediaPlayer } from "media-player.slint";
import { SystemTile, SystemPage } from "system-monitor.slint";
import { CalendarTile, CalendarPage } from "calendar.slint";

// Content of the expanded island.
export component ExpandedView inherits Rectangle {
    if AppState.page == Page.dashboard: VerticalLayout {
        padding: Theme.padding;
        spacing: 10px;

        MediaPlayer {
            height: 100px;
        }

        HorizontalLayout {
            height: 108px;
            spacing: Theme.gap;

            CalendarTile {
                horizontal-stretch: 1;
                clicked => {
                    AppState.page = Page.calendar;
                }
            }

            SystemTile {
                horizontal-stretch: 1;
                info: AppState.system;
                clicked => {
                    AppState.page = Page.system;
                }
            }
        }
    }

    if AppState.page == Page.calendar: CalendarPage {
        padding: Theme.padding;
    }

    if AppState.page == Page.system: SystemPage {
        padding: Theme.padding;
        info: AppState.system;
        back => {
            AppState.page = Page.dashboard;
        }
    }
}
