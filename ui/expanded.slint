import { Theme } from "theme.slint";
import { Page } from "types.slint";
import { AppState } from "state.slint";
import { Tile } from "components/controls.slint";
import { MediaPlayer } from "media-player.slint";
import { SystemTile, SystemPage } from "system-monitor.slint";

component ClockTile inherits Tile {
    label: "Date and time";

    VerticalLayout {
        padding: 12px;
        spacing: 1px;

        Text {
            text: AppState.weekday + " " + AppState.date;
            color: Theme.text-secondary;
            font-size: Theme.font-xs;
            font-weight: 600;
        }

        Text {
            text: AppState.time;
            color: Theme.text;
            font-size: Theme.font-xl;
            font-weight: 600;
        }
    }
}

// Content of the expanded island.
export component ExpandedView inherits Rectangle {
    if AppState.page == Page.dashboard: VerticalLayout {
        padding: Theme.padding;
        spacing: 10px;

        MediaPlayer {
            height: 100px;
        }

        HorizontalLayout {
            height: 108px;
            spacing: Theme.gap;

            ClockTile {
                horizontal-stretch: 1;
            }

            SystemTile {
                horizontal-stretch: 1;
                info: AppState.system;
                clicked => {
                    AppState.page = Page.system;
                }
            }
        }
    }

    if AppState.page == Page.system: SystemPage {
        padding: Theme.padding;
        info: AppState.system;
        back => {
            AppState.page = Page.dashboard;
        }
    }
}
