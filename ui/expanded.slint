import { Theme } from "theme.slint";
import { Page } from "types.slint";
import { AppState, AppActions } from "state.slint";
import { MediaPlayer } from "media-player.slint";
import { SystemTile, SystemPage } from "system-monitor.slint";
import { CalendarTile, CalendarPage } from "calendar.slint";
import { QuickActions } from "quick-actions.slint";
import { SoundPanel, BrightnessPanel, BluetoothPanel, WifiPanel } from "quick-panels.slint";
import { Icon, Icons } from "components/icon.slint";
import { IconButton } from "components/controls.slint";

// Content of the expanded island.
export component ExpandedView inherits Rectangle {
    property <bool> tiles: AppState.show-calendar || AppState.show-system || AppState.show-actions;

    if AppState.page == Page.dashboard: VerticalLayout {
        padding: Theme.padding;
        spacing: 10px;
        alignment: start;

        if AppState.show-media: MediaPlayer {
            height: 100px;
        }

        if root.tiles: HorizontalLayout {
            height: 108px;
            spacing: Theme.gap;

            if AppState.show-calendar: CalendarTile {
                horizontal-stretch: 1;
                clicked => {
                    AppState.page = Page.calendar;
                }
            }

            if AppState.show-system: SystemTile {
                horizontal-stretch: 1;
                info: AppState.system;
                clicked => {
                    AppState.page = Page.system;
                }
            }

            if AppState.show-actions: QuickActions {
                width: 144px;
                // The first four open a pop-up with the controls; index 5 opens the
                // Tasks + Clipboard shelf, the rest launch apps.
                activate(index) => {
                    if index < 4 {
                        AppState.page = [Page.sound, Page.brightness, Page.bluetooth, Page.wifi][index];
                    } else if index == 5 {
                        AppActions.open-shelf();
                    } else {
                        AppActions.quick-action(index);
                    }
                }
            }
        }

        // Every widget turned off: the island remains a clock.
        if !AppState.show-media && !root.tiles: VerticalLayout {
            height: 64px;
            alignment: center;

            Text {
                horizontal-alignment: center;
                text: AppState.time;
                color: Theme.text;
                font-size: Theme.font-xl;
                font-weight: 600;
            }

            Text {
                horizontal-alignment: center;
                text: AppState.weekday + " " + AppState.date;
                color: Theme.text-secondary;
                font-size: Theme.font-sm;
            }
        }

        HorizontalLayout {
            height: 30px;
            spacing: 6px;
            alignment: center;

            IconButton {
                icon: Icons.refresh;
                tooltip: "Check for updates";
                enabled: !AppState.update-checking;
                tint: Theme.text-secondary;
                clicked => { AppActions.check-for-updates(); }
            }

            if AppState.update-available: Rectangle {
                horizontal-stretch: 1;
                height: 30px;
                border-radius: Theme.control-radius;
                background: install-touch.pressed ? Theme.control-pressed : install-touch.has-hover ? Theme.control-hover : Theme.tile;
                accessible-role: button;
                accessible-label: AppState.update-message;
                accessible-action-default => { AppActions.install-update(); }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 7px;
                    alignment: center;
                    Icon { data: Icons.down; size: 15px; color: Theme.accent; }
                    Text {
                        horizontal-stretch: 1;
                        text: AppState.update-message;
                        color: Theme.text;
                        font-size: Theme.font-sm;
                        overflow: elide;
                    }
                    Text {
                        text: AppState.update-checking ? "" : "Install";
                        color: Theme.accent;
                        font-size: Theme.font-sm;
                        font-weight: 600;
                    }
                }
                install-touch := TouchArea {
                    mouse-cursor: pointer;
                    enabled: !AppState.update-checking;
                    clicked => { AppActions.install-update(); }
                }
            }

            if AppState.update-available: IconButton {
                icon: Icons.cloud;
                tooltip: "Open GitHub";
                tint: Theme.text-secondary;
                clicked => { AppActions.open-update(); }
            }

            if !AppState.update-available: Text {
                horizontal-stretch: 1;
                text: AppState.update-message;
                color: Theme.text-tertiary;
                font-size: Theme.font-sm;
                vertical-alignment: center;
            }
        }
    }

    if AppState.page == Page.calendar: CalendarPage {
        padding: Theme.padding;
    }

    if AppState.page == Page.sound: SoundPanel {
        padding: Theme.padding;
        padding-bottom: 8px;
    }

    if AppState.page == Page.brightness: BrightnessPanel {
        padding: Theme.padding;
        padding-bottom: 8px;
    }

    if AppState.page == Page.bluetooth: BluetoothPanel {
        padding: Theme.padding;
        padding-bottom: 8px;
    }

    if AppState.page == Page.wifi: WifiPanel {
        padding: Theme.padding;
        padding-bottom: 8px;
    }

    if AppState.page == Page.system: SystemPage {
        padding: Theme.padding;
        info: AppState.system;
        back => {
            AppState.page = Page.dashboard;
        }
    }
}
