import { Theme } from "theme.slint";
import { SystemInfo } from "types.slint";
import { AppState, AppActions } from "state.slint";
import { Icons, Icon } from "components/icon.slint";
import { Tile, Meter, IconButton } from "components/controls.slint";

struct Action {
    icon: string,
    tooltip: string,
}

// Single action capsule button in the horizontal strip
export component ActionPill inherits Rectangle {
    in property <string> icon;
    in property <string> tooltip;
    in property <color> tint: Theme.text-secondary;
    in property <bool> active: false;
    in property <length> size: 29px;
    callback clicked();

    width: root.size;
    height: root.size;
    border-radius: root.size < 27px ? 7px : 8px;
    background: root.active ? Theme.accent.with-alpha(0.25) : touch.pressed ? Theme.control-pressed : touch.has-hover ? Theme.control-hover : Theme.tile;
    animate background { duration: Theme.hover-duration; }
    accessible-role: button;
    accessible-label: root.tooltip;

    Icon {
        data: root.icon;
        size: root.size < 27px ? 13px : 14px;
        color: root.active ? Theme.accent : touch.has-hover ? Theme.text : root.tint;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component DeckMeter inherits HorizontalLayout {
    in property <string> label;
    in property <float> value;
    in property <string> value-text;
    in property <color> fill-color: Theme.accent;
    in property <length> item-spacing: 8px;
    in property <length> value-width: 32px;
    property <color> shown-fill: root.fill-color;
    animate shown-fill { duration: Theme.ambient-duration; easing: ease-in-out; }

    spacing: root.item-spacing;
    height: 16px;

    Text {
        width: 28px;
        vertical-alignment: center;
        text: root.label;
        color: Theme.text-secondary;
        font-size: 11px;
        font-weight: 600;
    }

    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;

        Rectangle {
            height: 4px;
            border-radius: 2px;
            background: Theme.track;
            clip: true;

            Rectangle {
                x: 0;
                width: max(0px, parent.width * clamp(root.value, 0, 1));
                height: 100%;
                border-radius: 2px;
                background: root.shown-fill;
                animate width { duration: Theme.fade-duration * 2; easing: ease-out; }
            }
        }
    }

    Text {
        width: root.value-width;
        vertical-alignment: center;
        horizontal-alignment: right;
        text: root.value-text;
        color: Theme.text;
        font-size: 11px;
        font-weight: 600;
    }
}

component DeckRate inherits HorizontalLayout {
    in property <string> icon;
    in property <string> text;
    in property <length> item-spacing: 5px;
    in property <length> font-size: 11.5px;
    spacing: root.item-spacing;
    height: 16px;

    VerticalLayout {
        alignment: center;
        Icon {
            data: root.icon;
            size: 11px;
            color: Theme.text-secondary;
        }
    }

    Text {
        vertical-alignment: center;
        text: root.text;
        color: Theme.text;
        font-size: root.font-size;
        font-weight: 500;
        overflow: elide;
    }
}

// Unified Right Card: Telemetry on top, 8-action strip on bottom
export component ControlDeck inherits Tile {
    in property <SystemInfo> info;
    in property <bool> show-system: true;
    in property <bool> show-actions: true;
    in property <length> deck-width: 296px;
    callback activate(int);
    callback open-system();
    label: "Control deck";

    property <bool> tight: root.deck-width < 275px;
    property <length> h-pad: root.tight ? 10px : 14px;
    property <length> strip-gap: root.tight ? 3px : 5px;
    property <length> pill-size: clamp(1px * floor(((root.deck-width - 2 * root.h-pad - 7 * root.strip-gap) / 1px) / 8), 20px, 29px);

    property <[Action]> actions: [
        { icon: Icons.volume, tooltip: "Volume" },
        { icon: Icons.sun, tooltip: "Brightness" },
        { icon: Icons.bluetooth, tooltip: "Bluetooth" },
        { icon: Icons.wifi, tooltip: "Wi-Fi" },
        { icon: Icons.scissors, tooltip: "Snipping Tool" },
        { icon: Icons.tasks, tooltip: "Tasks and Clipboard" },
        {
            icon: AppState.auto-hide ? Icons.eye-closed-lashes : Icons.eye-open-lashes,
            tooltip: AppState.auto-hide ? "Hide until pointed at (On)" : "Hide until pointed at (Off)",
        },
        { icon: Icons.settings, tooltip: "Lilt Settings" },
    ];

    VerticalLayout {
        padding-left: root.h-pad;
        padding-right: root.h-pad;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 6px;
        alignment: space-between;

        // Telemetry header: CPU & RAM on the left, Up & Down rates on the right
        if root.show-system : Rectangle {
            height: 44px;

            telemetry-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open-system(); }
            }

            HorizontalLayout {
                width: 100%;
                height: 100%;
                spacing: root.tight ? 8px : 14px;

                // CPU and RAM meters
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 6px;
                    alignment: center;

                    DeckMeter {
                        label: "CPU";
                        value: root.info.cpu;
                        value-text: root.info.ready ? root.info.cpu-text : "–";
                        item-spacing: root.tight ? 5px : 8px;
                        value-width: root.tight ? 28px : 32px;
                    }

                    DeckMeter {
                        label: "RAM";
                        value: root.info.memory;
                        value-text: root.info.ready ? root.info.memory-text : "–";
                        item-spacing: root.tight ? 5px : 8px;
                        value-width: root.tight ? 28px : 32px;
                    }
                }

                // Up / Down network rates
                VerticalLayout {
                    width: root.tight ? 64px : 72px;
                    spacing: 6px;
                    alignment: center;

                    DeckRate {
                        icon: Icons.up;
                        text: root.info.ready ? root.info.up-text : "–";
                        item-spacing: root.tight ? 4px : 5px;
                        font-size: root.tight ? 10.5px : 11.5px;
                    }

                    DeckRate {
                        icon: Icons.down;
                        text: root.info.ready ? root.info.down-text : "–";
                        item-spacing: root.tight ? 4px : 5px;
                        font-size: root.tight ? 10.5px : 11.5px;
                    }
                }
            }
        }

        // Horizontal Action Strip (8 icons)
        if root.show-actions : HorizontalLayout {
            spacing: root.strip-gap;
            alignment: center;
            height: 30px;

            for action[i] in root.actions : ActionPill {
                size: root.pill-size;
                icon: action.icon;
                tooltip: action.tooltip;
                active: i == 6 && AppState.auto-hide;
                tint: (i == 6 && AppState.auto-hide) ? Theme.accent : Theme.text-secondary;
                clicked => { root.activate(i); }
            }
        }
    }
}

// Order must match `QuickAction::ALL` in src/actions.rs.
export component QuickActions inherits Tile {
    callback activate(int);
    label: "Quick actions";

    property <[Action]> first-row: [
        { icon: Icons.volume, tooltip: "Volume" },
        { icon: Icons.sun, tooltip: "Brightness" },
        { icon: Icons.bluetooth, tooltip: "Bluetooth" },
        { icon: Icons.wifi, tooltip: "Wi-Fi" },
    ];
    property <[Action]> second-row: [
        { icon: Icons.scissors, tooltip: "Snipping Tool" },
        // Opens the Tasks + Clipboard shelf, even when both are off in Settings.
        { icon: Icons.tasks, tooltip: "Tasks and Clipboard" },
        {
            icon: AppState.auto-hide ? Icons.eye-closed-lashes : Icons.eye-open-lashes,
            tooltip: AppState.auto-hide ? "Hide until pointed at (On)" : "Hide until pointed at (Off)",
        },
        { icon: Icons.settings, tooltip: "Lilt Settings" },
    ];

    VerticalLayout {
        padding: 9px;
        spacing: 2px;
        alignment: center;

        HorizontalLayout {
            spacing: 2px;
            alignment: center;
            for action[i] in root.first-row : IconButton {
                icon: action.icon;
                tooltip: action.tooltip;
                tint: Theme.text-secondary;
                clicked => { root.activate(i); }
            }
        }

        HorizontalLayout {
            spacing: 2px;
            alignment: center;
            for action[i] in root.second-row : IconButton {
                icon: action.icon;
                tooltip: action.tooltip;
                tint: Theme.text-secondary;
                clicked => { root.activate(i + 4); }
            }
        }
    }
}
