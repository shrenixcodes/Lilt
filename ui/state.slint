import {
    AgendaEntry, AppLauncherItem, ArchiveRow, CalendarState, ClipFilter, ClipRow, DeviceRow, MediaInfo, NetworkRow, Page, SessionRow, SidePanel, SnippetForm, SyncStatus, SystemInfo,
    TaskForm, TaskRow, TaskView, TasksLayout,
} from "types.slint";

// Data published by the Rust side. Views read from here instead of receiving every
// value through a chain of component properties.
export global AppState {
    in property <length> compact-width: 196px;
    in property <length> expanded-width: 460px;
    in property <bool> allow-drag: true;
    in property <bool> center-snapped;

    // Widgets enabled in Settings.
    in property <bool> show-media: true;
    in property <bool> show-calendar: true;
    in property <bool> show-system: true;
    in property <bool> show-actions: true;
    in property <bool> show-artwork: true;
    in property <bool> show-progress: true;
    // When off the compact island keeps the now-playing visualizer on hover instead
    // of swapping it for the play/next buttons.
    in property <bool> hover-controls: true;

    // Clock
    in property <string> time;
    in property <string> weekday;
    in property <string> date;
    in property <string> weather;
    in property <int> idle-index;
    in property <bool> idle-visible: true;

    // Media
    in property <MediaInfo> media;
    in property <bool> media-grace;
    in property <image> artwork;
    in property <bool> has-artwork;
    in property <float> progress;
    in property <string> position-text;
    in property <string> duration-text;
    // A short-lived banner after the track changes.
    in property <bool> activity;

    // System readings, sampled only while the expanded island is visible.
    in property <SystemInfo> system;

    // Calendar
    in property <CalendarState> calendar-state;
    in property <string> calendar-message;
    // File name of the calendar being shown.
    in property <string> calendar-source;
    in property <[AgendaEntry]> agenda;

    // Set by Rust; the island only requests changes through AppActions.
    in property <bool> expanded;
    // Tracked by the native island window, including when the pointer is over child controls.
    in property <bool> pointer-inside;
    // The island is shown (not hidden by the user or for a full-screen application).
    in property <bool> on-screen: true;
    // Auto-hide: the island is tucked away above the top edge and reveals only when the
    // pointer reaches the top centre of the screen.
    in property <bool> tucked: false;
    in-out property <bool> auto-hide: false;
    in property <bool> update-checking;
    in property <bool> update-available;
    in property <string> update-message: "Check for updates";
    // Steps of the "now playing" bars, advanced by the application about 14 times a
    // second while music plays and the compact island is on screen.
    in property <int> bars-step;
    in-out property <Page> page: Page.dashboard;

    // The tasks box is enabled in Settings, and where it sits.
    in property <bool> show-tasks: false;
    in property <TasksLayout> tasks-layout: TasksLayout.beside;
    // The clipboard shelf is enabled in Settings, and which panel the box shows.
    in property <bool> show-clipboard: false;
    in-out property <SidePanel> side-panel: SidePanel.tasks;
    // The side box is forced open by the Tasks+Clipboard quick-action, even when both
    // are off in Settings. Reset when the island collapses.
    in-out property <bool> force-side-panel: false;
    // What the island should actually show, factoring in the force.
    out property <bool> effective-tasks: show-tasks || force-side-panel;
    out property <bool> effective-clipboard: show-clipboard || force-side-panel;

    // Collapsed island App Launcher
    in property <bool> launcher-enabled: true;
    in-out property <bool> launcher-active: false;
    in property <[AppLauncherItem]> launcher-apps;
    in-out property <int> launcher-index: 0;
    in-out property <int> launcher-direction: 0;
    in-out property <int> launcher-anim-token: 0;
}

// The clipboard shelf, published by the Rust side.
export global ClipboardState {
    in property <bool> ready;
    in property <string> error;
    in property <[ClipRow]> rows;
    // Index into `rows` of the entry chosen with the keyboard, or -1.
    in property <int> selected: -1;
    // "Remembering copied text · 42 items", "Paused", …
    in property <string> status;
    in property <bool> capture-on;
    in property <bool> paused;
    // Clipboard capture has not been offered yet: the shelf explains it first.
    in property <bool> show-intro;
    in property <string> empty-title;
    in property <string> empty-detail;
    // The entry just copied back, for its "Copied" confirmation, or 0.
    in property <int> copied-id;
    // A short message such as "Copied" or "Not saved: looks like a password".
    in property <string> notice;
    in property <int> history-count;
    // Incremented to put the keyboard focus in the search field.
    in-out property <int> search-focus;
    // The y of the selected entry within the list, to keep it in view.
    in property <length> selected-top;
    // Incremented on backend selection updates so the list still scrolls when the row index stays unchanged.
    in property <int> scroll-token;

    in-out property <string> search;
    in-out property <ClipFilter> filter: ClipFilter.all;
    in-out property <bool> editing;
    in-out property <SnippetForm> form;
}

export global ClipboardActions {
    // The shelf is shown and needs its data.
    callback opened();
    callback search-changed(string);
    callback filter-changed();
    // Copies an entry back to the clipboard; `close` also collapses the island.
    callback copy(int, bool);
    callback toggle-pin(int);
    callback delete(int);
    // Opens an entry in the snippet editor; 0 starts a new snippet.
    callback edit(int);
    callback save(SnippetForm);
    // Keyboard selection: moves by `delta` entries, or acts on the selected entry.
    callback move-selection(int);
    callback copy-selected();
    callback delete-selected();
    // Answer to the first-use explanation, and the capture controls.
    callback set-capture(bool);
    callback dismiss-intro();
    callback set-paused(bool);
    callback clear-history();
    callback open-settings();
    // A text field is being edited: the island must not collapse by itself.
    callback busy(bool);
}

// Tasks, published by the Rust side. Kept in a global so the box's state survives
// collapsing the island.
export global TasksState {
    in property <bool> ready;
    // Why tasks are unavailable (for example the database could not be opened).
    in property <string> error;
    in property <[TaskRow]> rows;
    in property <[ArchiveRow]> archive;
    in property <string> date-label;
    in property <int> open-count;
    in property <int> due-today-count;
    in property <int> upcoming-count;
    in property <int> done-today;
    in property <int> left-today;
    // No open tasks at all; `first-use` when no task was ever created.
    in property <bool> nothing-open;
    in property <bool> first-use;
    in property <string> empty-title;
    in property <string> empty-detail;
    in property <bool> custom-order;
    in property <[string]> categories;

    in-out property <TaskView> view: TaskView.all;
    // -1 for every priority.
    in-out property <int> priority-filter: -1;
    in-out property <string> search;

    // Quick add, kept here so a half-typed task survives collapsing the island.
    in-out property <bool> adding;
    in-out property <string> draft;
    in-out property <int> draft-priority: 0;
    in-out property <int> draft-due: -10000;
    in-out property <string> draft-time;
    in-out property <string> draft-category;
    in property <string> draft-error;

    in-out property <bool> editing;
    in-out property <TaskForm> form;

    in property <string> undo-text;
    in property <bool> undo-visible;

    // Google
    in property <SyncStatus> sync-status: SyncStatus.none;
    in property <string> sync-text;
    in property <bool> google-available;
}

export global TasksActions {
    // Title, priority (0..4), due offset in days (-10000 for none), time, category.
    callback quick-add(string, int, int, string, string);
    callback complete(int);
    callback undo();
    callback edit(int);
    callback save(TaskForm);
    callback delete(int);
    callback defer(int);
    // -1 up, 1 down, within the task's priority in the custom order.
    callback move(int, int);
    callback toggle-order();
    callback view-changed();
    callback search-changed(string);
    callback restore(int);
    callback delete-completed(int);
    callback clear-completed();
    callback refresh();
    callback connect-google();
    // The box needs its data, for example when it is shown.
    callback opened();
    // Moves the tasks box beside or below the island.
    callback toggle-layout();
    // A text field is being edited: the island must not collapse by itself.
    callback busy(bool);
    // "Today", "Tomorrow", "Mon 17", … for a day offset.
    pure callback day-label(int) -> string;
    // Whether text is a valid time of day such as 17:30 or 5:30 pm.
    pure callback time-valid(string) -> bool;
}

// The quick-control pop-ups (Sound, Brightness, Bluetooth, Wi-Fi), published by the Rust
// side while one is open.
export global ControlsState {
    // Nothing has been read yet for the open pop-up.
    in property <bool> loading: true;
    // A short message in the open pop-up, such as a failed connection.
    in property <string> message;

    in property <bool> wifi-available;
    // -1 unknown, 0 off, 1 on; the same for Bluetooth.
    in property <int> wifi-radio: -1;
    in property <[NetworkRow]> networks;
    // The network being joined.
    in property <string> wifi-connecting;
    // The network whose password field is open, and the typed draft preserved across refreshes.
    in-out property <string> wifi-password-for;
    in-out property <string> wifi-password;
    // Focus state for numeric inputs or password boxes so island-wide shortcuts stand down.
    in-out property <bool> input-busy;

    in property <int> bluetooth-radio: -1;
    in property <[DeviceRow]> devices;

    in property <bool> sound-available;
    in property <float> volume;
    in property <bool> muted;
    in property <string> output-name;
    in property <[string]> output-names;
    in property <[string]> output-ids;
    in property <int> output-index: -1;
    in property <[string]> input-names;
    in property <[string]> input-ids;
    in property <int> input-index: -1;
    in property <bool> input-available;
    in property <float> input-volume;
    in property <bool> input-muted;
    // The per-app mixer. Empty when nothing is playing on the default output.
    in property <[SessionRow]> sessions;

    in property <bool> brightness-available;
    in property <float> brightness;
}

export global ControlsActions {
    // 0 Sound, 1 Brightness, 2 Bluetooth, 3 Wi-Fi: the pop-up opened.
    callback opened(int);
    callback set-radio(int, bool);
    callback join(string, string);
    callback disconnect-wifi();
    callback connect-device(string, string, bool);
    callback select-endpoint(string);
    callback set-input-volume(float);
    callback set-input-muted(bool);
    callback set-volume(float);
    callback set-muted(bool);
    callback set-session-volume(string, float);
    callback set-session-muted(string, bool);
    callback set-brightness(float);
    // Opens the matching Windows Settings page.
    callback more-settings(int);
    // A password is being typed: the island must not collapse by itself.
    callback busy(bool);
}

// User intents handled on the Rust side.
export global AppActions {
    callback check-for-updates();
    callback open-update();
    /// Downloads and runs the latest installer.
    callback install-update();
    callback start-drag();
    callback idle-changed(bool);
    callback toggle-expanded();
    callback collapse();
    callback toggle-play();
    callback next-track();
    callback previous-track();
    callback seek(float);
    callback cycle-source();
    callback choose-calendar();
    // Index into the actions listed in ui/quick-actions.slint.
    callback quick-action(int);
    callback open-settings();
    // Opens the side box with Tasks and Clipboard, even if both are off in Settings.
    callback open-shelf();
    // Collapsed island App Launcher
    callback toggle-launcher();
    callback scroll-launcher(int);
    callback launch-app(int);
    callback toggle-auto-hide();
}
