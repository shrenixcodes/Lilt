import { AgendaEntry, CalendarState, MediaInfo, Page, SystemInfo } from "types.slint";

// Data published by the Rust side. Views read from here instead of receiving every
// value through a chain of component properties.
export global AppState {
    in property <length> compact-width: 196px;
    in property <length> expanded-width: 460px;
    in property <bool> allow-drag: true;

    // Widgets enabled in Settings.
    in property <bool> show-media: true;
    in property <bool> show-calendar: true;
    in property <bool> show-system: true;
    in property <bool> show-actions: true;
    in property <bool> show-artwork: true;
    in property <bool> show-progress: true;

    // Clock
    in property <string> time;
    in property <string> weekday;
    in property <string> date;

    // Media
    in property <MediaInfo> media;
    in property <image> artwork;
    in property <bool> has-artwork;
    in property <float> progress;
    in property <string> position-text;
    in property <string> duration-text;
    // A short-lived banner after the track changes.
    in property <bool> activity;

    // System readings, sampled only while the expanded island is visible.
    in property <SystemInfo> system;

    // Calendar
    in property <CalendarState> calendar-state;
    in property <string> calendar-message;
    // File name of the calendar being shown.
    in property <string> calendar-source;
    in property <[AgendaEntry]> agenda;

    // Set by Rust; the island only requests changes through AppActions.
    in property <bool> expanded;
    in-out property <Page> page: Page.dashboard;
}

// User intents handled on the Rust side.
export global AppActions {
    callback start-drag();
    callback toggle-expanded();
    callback collapse();
    callback toggle-play();
    callback next-track();
    callback previous-track();
    callback seek(float);
    callback cycle-source();
    callback choose-calendar();
    // Index into the actions listed in ui/quick-actions.slint.
    callback quick-action(int);
    callback open-settings();
}
