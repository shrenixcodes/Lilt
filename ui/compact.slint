import { Theme } from "theme.slint";
import { MediaAvailability } from "types.slint";
import { AppState } from "state.slint";
import { ArtworkTile } from "artwork.slint";

// "Now playing" bars. Deliberately static: the heights only change, once, when playback
// starts or stops, so the compact island never animates continuously.
component PlayingGlyph inherits Rectangle {
    in property <bool> playing;
    width: 15px;
    height: 14px;

    for h[i] in [8px, 13px, 6px, 11px] : Rectangle {
        x: i * 4px;
        y: (root.height - self.height) / 2;
        width: 2.5px;
        height: root.playing ? h : 3px;
        border-radius: 1.25px;
        background: root.playing ? Theme.accent : Theme.text-tertiary;
        animate height, background { duration: Theme.resize-duration; easing: ease-out; }
    }
}

// The resting island: the date and time when idle, the current track while media is
// active.
export component CompactView inherits Rectangle {
    in property <bool> media-mode;

    Rectangle {
        opacity: root.media-mode ? 0 : 1;
        animate opacity { duration: Theme.fade-duration; }

        HorizontalLayout {
            padding-left: 17px;
            padding-right: 17px;
            alignment: space-between;

            Text {
                vertical-alignment: center;
                text: AppState.weekday + " " + AppState.date;
                color: Theme.text-secondary;
                font-size: Theme.font-sm;
            }

            Text {
                vertical-alignment: center;
                text: AppState.time;
                color: Theme.text;
                font-size: Theme.font-md;
                font-weight: 600;
            }
        }
    }

    if root.media-mode : HorizontalLayout {
        padding-left: 7px;
        padding-right: 15px;
        spacing: 10px;
        opacity: 0;
        animate opacity { duration: Theme.fade-duration; }
        init => {
            self.opacity = 1;
        }

        VerticalLayout {
            alignment: center;
            ArtworkTile { size: 24px; }
        }

        Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            text: AppState.media.title;
            color: Theme.text-secondary;
            font-size: Theme.font-sm;
            overflow: elide;
        }

        VerticalLayout {
            alignment: center;
            PlayingGlyph { playing: AppState.media.playing; }
        }
    }
}

// Shown briefly in place of the compact island when the track changes.
export component ActivityView inherits Rectangle {
    HorizontalLayout {
        padding: 11px;
        padding-right: 18px;
        spacing: 12px;

        ArtworkTile { size: 40px; }

        VerticalLayout {
            alignment: center;
            spacing: 1px;

            Text {
                text: AppState.media.playing ? "Now playing" : "Paused";
                color: Theme.accent;
                animate color { duration: Theme.ambient-duration; }
                font-size: Theme.font-xs;
                font-weight: 600;
            }

            Text {
                text: AppState.media.title;
                color: Theme.text;
                font-size: Theme.font-md;
                font-weight: 600;
                overflow: elide;
            }

            Text {
                text: AppState.media.artist;
                color: Theme.text-secondary;
                font-size: Theme.font-sm;
                overflow: elide;
            }
        }
    }
}
