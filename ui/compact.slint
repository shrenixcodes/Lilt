import { MarqueeText } from "components/marquee.slint";
import { Theme } from "theme.slint";
import { AppLauncherItem, MediaAvailability } from "types.slint";
import { AppState, AppActions } from "state.slint";
import { ArtworkTile } from "artwork.slint";
import { IconButton } from "components/controls.slint";
import { Icon, Icons } from "components/icon.slint";

// "Now playing" bars. While music plays they move like an equalizer: the application
// advances `AppState.bars-step` about 14 times a second, with no per-frame animation,
// and only while the compact island is on screen. Paused or stopped they settle once
// into the flat idle shape; with reduced motion they keep their original still heights.
component PlayingGlyph inherits Rectangle {
    in property <bool> playing;
    // The glyph can be seen: the compact island is on screen and not covered.
    in property <bool> live: true;
    width: 17px;
    height: 16px;

    property <bool> moving: root.playing && root.live && Theme.motion > 0;
    // Every wave below repeats after 360 steps; the application wraps at a multiple.
    property <int> step: AppState.bars-step;

    for h[i] in [9px, 15px, 7px, 13px] : Rectangle {
        // Two waves per bar at different speeds, so the bars never move in step.
        property <float> level: 0.5 + 0.3 * sin((root.step * (37 + 11 * i) + 71 * i) * 1deg)
            + 0.2 * sin((root.step * (23 + 7 * i) + 43 * i) * 1deg);
        x: i * 4.5px;
        y: (root.height - self.height) / 2;
        width: 3px;
        height: !root.playing ? 3px : root.moving ? 3px + self.level * 13px : h;
        border-radius: 1.5px;
        background: root.playing ? Theme.accent : Theme.text-tertiary;
        // Steps are drawn as they come; only settling into a still shape is animated.
        animate height { duration: root.moving ? 0ms : Theme.resize-duration; easing: ease-out; }
        animate background { duration: Theme.resize-duration; easing: ease-out; }
    }
}

// App Launcher view on the collapsed island when scrolling or middle-clicked.
component AppLauncherView inherits Rectangle {
    property <int> total: AppState.launcher-apps.length;
    property <int> idx: AppState.launcher-index;
    property <AppLauncherItem> current: root.total > 0 ? AppState.launcher-apps[root.idx] : { name: "No Apps", path: "", icon-kind: "app" };

    property <length> slide-y: AppState.launcher-direction > 0 ? 0px : -1px;
    property <float> item-opacity: 1.0;
    animate slide-y { duration: 160ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }
    animate item-opacity { duration: 140ms; easing: ease-out; }

    VerticalLayout {
        alignment: center;

        HorizontalLayout {
            alignment: center;

            // Click target covers ONLY the icon and the name
            launch-target := Rectangle {
                border-radius: 8px;
                background: target-touch.has-hover ? Theme.tile-hover : transparent;
                animate background { duration: Theme.hover-duration; }

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 10px;
                    padding-top: 3px;
                    padding-bottom: 3px;
                    spacing: 8px;
                    alignment: center;

                    // App Icon directly - NO bubble/border/tile wrapper
                    VerticalLayout {
                        alignment: center;
                        y: root.slide-y;
                        opacity: root.item-opacity;

                        Rectangle {
                            width: 18px;
                            height: 18px;

                            if root.current.has-icon : Image {
                                width: 18px;
                                height: 18px;
                                source: root.current.icon;
                            }

                            if !root.current.has-icon : Icon {
                                size: 16px;
                                color: Theme.accent;
                                data: root.current.icon-kind == "code" ? Icons.cpu
                                    : root.current.icon-kind == "game" ? Icons.disc
                                    : root.current.icon-kind == "art" ? Icons.picture
                                    : root.current.icon-kind == "terminal" ? Icons.activity
                                    : root.current.icon-kind == "browser" ? Icons.globe
                                    : Icons.folder;
                            }
                        }
                    }

                    // App Name
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        y: root.slide-y;
                        opacity: root.item-opacity;

                        Text {
                            text: root.current.name;
                            font-size: 11.5px;
                            font-weight: 600;
                            color: Theme.text;
                            overflow: elide;
                        }

                        Text {
                            text: root.total > 0 ? ((root.idx + 1) + " of " + root.total) : "Configure in Settings";
                            font-size: 8.5px;
                            color: Theme.text-tertiary;
                            overflow: elide;
                        }
                    }
                }

                target-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        AppActions.launch-app(AppState.launcher-index);
                    }
                }
            }
        }
    }
}

// The resting island: the date and time when idle, the current track while media is
// active.
export component CompactView inherits Rectangle {
    in property <bool> media-mode;
    in property <bool> hovered;
    // The controls receive pointer input themselves, so retain hover while moving over
    // either button or the small gap between them.
    in-out property <bool> strip-hovered: false;
    in-out property <bool> play-hovered: false;
    in-out property <bool> next-hovered: false;
    // With hover controls off the visualizer stays visible and the play/next buttons
    // are hidden; the island's own click still expands it as before.
    property <bool> show-controls: AppState.hover-controls
        && (root.hovered || root.strip-hovered || root.play-hovered || root.next-hovered);
    changed media-mode => {
        if !root.media-mode {
            root.strip-hovered = false;
            root.play-hovered = false;
            root.next-hovered = false;
        }
    }

    if AppState.launcher-active : AppLauncherView {
        width: parent.width;
        height: parent.height;
    }

    Rectangle {
        visible: !AppState.launcher-active;
        opacity: root.media-mode ? 0 : 1;
        animate opacity { duration: Theme.fade-duration; }

        MarqueeText {
            live: !root.media-mode && !AppState.expanded && !AppState.launcher-active;
            centered: true;
            x: 12px;
            width: parent.width - 24px;
            height: parent.height;
            text: AppState.idle-index == 0 ? AppState.time
                : AppState.idle-index == 1 ? AppState.weekday + " " + AppState.date
                : AppState.weather;
            tint: Theme.text;
            font-size: Theme.font-md;
            font-weight: 600;
            opacity: AppState.idle-visible ? 1 : 0;
            animate opacity { duration: Theme.fade-duration; }
        }
    }

    if root.media-mode && !AppState.launcher-active : HorizontalLayout {
        padding-left: 7px;
        padding-right: 15px;
        spacing: 10px;
        opacity: 0;
        animate opacity { duration: Theme.fade-duration; }
        init => {
            self.opacity = 1;
        }

        VerticalLayout {
            alignment: center;
            ArtworkTile { size: 24px; }
        }

        MarqueeText {
            live: !AppState.expanded && !AppState.activity;
            text: AppState.media.title;
            tint: Theme.text-secondary;
            font-size: Theme.font-sm;
        }

        Rectangle {
            width: root.show-controls ? 54px : 17px;
            height: parent.height;
            animate width { duration: Theme.hover-duration; easing: ease-out; }

            // Sits behind the buttons and covers the 2 px gap between them.
            controls-hover := TouchArea {
                changed has-hover => { root.strip-hovered = self.has-hover; }
            }

            PlayingGlyph {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                playing: AppState.media.playing;
                live: AppState.on-screen && !AppState.expanded && !AppState.activity;
                opacity: root.show-controls ? 0 : 1;
                animate opacity { duration: Theme.fade-duration; }
            }

            HorizontalLayout {
                y: (parent.height - self.height) / 2;
                width: 54px;
                height: 26px;
                spacing: 2px;
                opacity: root.show-controls ? 1 : 0;
                animate opacity { duration: Theme.fade-duration; }

                play := IconButton {
                    width: 26px;
                    height: 26px;
                    icon: AppState.media.playing ? Icons.pause : Icons.play;
                    icon-size: 13px;
                    filled: true;
                    enabled: root.show-controls && AppState.media.can-play-pause;
                    tooltip: AppState.media.playing ? "Pause" : "Play";
                    hover-changed(hovered) => { root.play-hovered = hovered; }
                    clicked => { AppActions.toggle-play(); }
                }

                next := IconButton {
                    width: 26px;
                    height: 26px;
                    icon: Icons.next;
                    icon-size: 14px;
                    filled: true;
                    enabled: root.show-controls && AppState.media.can-next;
                    tooltip: "Next track";
                    hover-changed(hovered) => { root.next-hovered = hovered; }
                    clicked => { AppActions.next-track(); }
                }
            }
        }
    }
}

// Shown briefly in place of the compact island when the track changes.
export component ActivityView inherits Rectangle {
    HorizontalLayout {
        padding: 11px;
        padding-right: 18px;
        spacing: 12px;

        ArtworkTile { size: 40px; }

        VerticalLayout {
            alignment: center;
            spacing: 1px;

            Text {
                text: AppState.media.playing ? "Now playing" : "Paused";
                color: Theme.accent;
                animate color { duration: Theme.ambient-duration; }
                font-size: Theme.font-xs;
                font-weight: 600;
            }

            MarqueeText {
                live: AppState.activity && !AppState.expanded;
                text: AppState.media.title;
                tint: Theme.text;
                font-size: Theme.font-md;
                font-weight: 600;
            }

            MarqueeText {
                live: AppState.activity && !AppState.expanded;
                text: AppState.media.artist;
                tint: Theme.text-secondary;
                font-size: Theme.font-sm;
            }
        }
    }
}
