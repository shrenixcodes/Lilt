import { Theme } from "theme.slint";
import { MediaAvailability } from "types.slint";
import { AppState, AppActions } from "state.slint";
import { ArtworkTile } from "artwork.slint";
import { IconButton } from "components/controls.slint";
import { Icons } from "components/icon.slint";

// "Now playing" bars. While music plays they move like an equalizer: the application
// advances `AppState.bars-step` about 14 times a second, with no per-frame animation,
// and only while the compact island is on screen. Paused or stopped they settle once
// into the flat idle shape; with reduced motion they keep their original still heights.
component PlayingGlyph inherits Rectangle {
    in property <bool> playing;
    // The glyph can be seen: the compact island is on screen and not covered.
    in property <bool> live: true;
    width: 17px;
    height: 16px;

    property <bool> moving: root.playing && root.live && Theme.motion > 0;
    // Every wave below repeats after 360 steps; the application wraps at a multiple.
    property <int> step: AppState.bars-step;

    for h[i] in [9px, 15px, 7px, 13px] : Rectangle {
        // Two waves per bar at different speeds, so the bars never move in step.
        property <float> level: 0.5 + 0.3 * sin((root.step * (37 + 11 * i) + 71 * i) * 1deg)
            + 0.2 * sin((root.step * (23 + 7 * i) + 43 * i) * 1deg);
        x: i * 4.5px;
        y: (root.height - self.height) / 2;
        width: 3px;
        height: !root.playing ? 3px : root.moving ? 3px + self.level * 13px : h;
        border-radius: 1.5px;
        background: root.playing ? Theme.accent : Theme.text-tertiary;
        // Steps are drawn as they come; only settling into a still shape is animated.
        animate height { duration: root.moving ? 0ms : Theme.resize-duration; easing: ease-out; }
        animate background { duration: Theme.resize-duration; easing: ease-out; }
    }
}

// The resting island: the date and time when idle, the current track while media is
// active.
export component CompactView inherits Rectangle {
    in property <bool> media-mode;
    in property <bool> hovered;

    Rectangle {
        opacity: root.media-mode ? 0 : 1;
        animate opacity { duration: Theme.fade-duration; }

        HorizontalLayout {
            padding-left: 17px;
            padding-right: 17px;
            alignment: space-between;

            Text {
                vertical-alignment: center;
                text: AppState.weekday + " " + AppState.date;
                color: Theme.text-secondary;
                font-size: Theme.font-sm;
            }

            Text {
                vertical-alignment: center;
                text: AppState.time;
                color: Theme.text;
                font-size: Theme.font-md;
                font-weight: 600;
            }
        }
    }

    if root.media-mode : HorizontalLayout {
        padding-left: 7px;
        padding-right: 15px;
        spacing: 10px;
        opacity: 0;
        animate opacity { duration: Theme.fade-duration; }
        init => {
            self.opacity = 1;
        }

        VerticalLayout {
            alignment: center;
            ArtworkTile { size: 24px; }
        }

        Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            text: AppState.media.title;
            color: Theme.text-secondary;
            font-size: Theme.font-sm;
            overflow: elide;
        }

        Rectangle {
            width: root.hovered ? 54px : 17px;
            height: parent.height;
            animate width { duration: Theme.hover-duration; easing: ease-out; }

            PlayingGlyph {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                playing: AppState.media.playing;
                live: AppState.on-screen && !AppState.expanded && !AppState.activity;
                opacity: root.hovered ? 0 : 1;
                animate opacity { duration: Theme.fade-duration; }
            }

            HorizontalLayout {
                y: (parent.height - self.height) / 2;
                width: 54px;
                height: 26px;
                spacing: 2px;
                opacity: root.hovered ? 1 : 0;
                animate opacity { duration: Theme.fade-duration; }

                IconButton {
                    width: 26px;
                    height: 26px;
                    icon: AppState.media.playing ? Icons.pause : Icons.play;
                    icon-size: 13px;
                    filled: true;
                    enabled: root.hovered && AppState.media.can-play-pause;
                    tooltip: AppState.media.playing ? "Pause" : "Play";
                    clicked => { AppActions.toggle-play(); }
                }

                IconButton {
                    width: 26px;
                    height: 26px;
                    icon: Icons.next;
                    icon-size: 14px;
                    filled: true;
                    enabled: root.hovered && AppState.media.can-next;
                    tooltip: "Next track";
                    clicked => { AppActions.next-track(); }
                }
            }
        }
    }
}

// Shown briefly in place of the compact island when the track changes.
export component ActivityView inherits Rectangle {
    HorizontalLayout {
        padding: 11px;
        padding-right: 18px;
        spacing: 12px;

        ArtworkTile { size: 40px; }

        VerticalLayout {
            alignment: center;
            spacing: 1px;

            Text {
                text: AppState.media.playing ? "Now playing" : "Paused";
                color: Theme.accent;
                animate color { duration: Theme.ambient-duration; }
                font-size: Theme.font-xs;
                font-weight: 600;
            }

            Text {
                text: AppState.media.title;
                color: Theme.text;
                font-size: Theme.font-md;
                font-weight: 600;
                overflow: elide;
            }

            Text {
                text: AppState.media.artist;
                color: Theme.text-secondary;
                font-size: Theme.font-sm;
                overflow: elide;
            }
        }
    }
}
