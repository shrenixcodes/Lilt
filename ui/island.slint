import { Theme } from "theme.slint";
import { MediaAvailability, Page, SidePanel, TasksLayout } from "types.slint";
import { AppState, AppActions, ClipboardState, ClipboardActions, ControlsActions, ControlsState, TasksState } from "state.slint";
import { CompactView, ActivityView } from "compact.slint";
import { ExpandedView } from "expanded.slint";
import { TasksView } from "tasks.slint";
import { ClipboardView } from "clipboard.slint";
import { GlassSheen, GlassRim } from "components/glass.slint";

// Two translucent layers that approximate a soft drop shadow, which the software
// renderer does not draw. Place it before the surface it belongs to.
component Shadow inherits Rectangle {
    in property <length> radius;

    Rectangle {
        x: -3px;
        y: 1px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: root.radius + 3px;
        background: Theme.shadow-far;
    }

    Rectangle {
        x: -1px;
        y: 1px;
        width: parent.width + 2px;
        height: parent.height + 2px;
        border-radius: root.radius + 1px;
        background: Theme.shadow-near;
    }
}

export component Island inherits Window {
    title: "Lilt";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: Theme.font;

    // With Tasks or the clipboard shelf enabled, the expanded island is two boxes: the
    // dashboard and the side box, side by side or one below the other. The Tasks +
    // Clipboard quick action forces both on without changing Settings.
    property <bool> tasks-box: AppState.effective-tasks || AppState.effective-clipboard;
    // Which panel the side box shows.
    property <bool> clipboard-panel: AppState.effective-clipboard && (AppState.side-panel == SidePanel.clipboard || !AppState.effective-tasks);
    property <bool> beside: AppState.tasks-layout == TasksLayout.beside;
    property <length> gap: 10px;
    property <length> tasks-width: root.beside ? 400px : AppState.expanded-width;
    // Beside the island the side box matches the island's height so the pair aligns at
    // the bottom and there is more room for the list; below, it keeps a comfortable
    // preset so the window doesn't become too tall.
    property <length> tasks-height: root.beside ? max(360px, root.expanded-height) : 320px;
    property <length> pair-width: AppState.expanded-width + (root.tasks-box && root.beside ? root.gap + root.tasks-width : 0px);

    // The window covers the largest state plus room for the shadow. Transparent pixels
    // are click-through, so the unused area never blocks other windows.
    width: max(root.pair-width, 340px) + 2 * Theme.margin;
    height: (!root.tasks-box ? root.panel-height : root.beside ? max(root.panel-height, root.tasks-height) : root.panel-height + root.gap + root.tasks-height)
        + 2 * Theme.margin;
    // The window's size, for the UI tests.
    out property <length> window-width: root.width;
    out property <length> window-height: root.height;

    property <bool> tiles: AppState.show-calendar || AppState.show-system || AppState.show-actions;
    // Height of the dashboard for the enabled widgets; detail pages need at least 214 px.
    out property <length> dashboard-height: Theme.padding * 2
        + (AppState.show-media ? 100px : 0)
        + (AppState.show-media && root.tiles ? 10px : 0)
        + (root.tiles ? 108px : 0)
        + (!AppState.show-media && !root.tiles ? 64px : 0);
    property <length> panel-height: max(AppState.page == Page.sound ? 460px : 250px, root.dashboard-height);
    // Quick-control pop-ups need room for a short list.
    out property <length> expanded-height: AppState.page == Page.dashboard ? root.dashboard-height
        : AppState.page == Page.calendar || AppState.page == Page.system ? max(root.dashboard-height, 214px)
        : AppState.page == Page.sound ? 460px : 250px;
    property <length> activity-width: 340px;

    property <bool> media-mode: AppState.show-media && (AppState.media-grace || (AppState.media.availability == MediaAvailability.active
        && (AppState.media.playing || AppState.pointer-inside)));
    property <bool> idle-active: AppState.on-screen && !AppState.expanded && !root.media-mode;
    changed idle-active => { AppActions.idle-changed(root.idle-active); }
    property <bool> showing-activity: AppState.activity && !AppState.expanded && root.media-mode;
    property <bool> compact-progress: root.media-mode && !AppState.expanded && !root.showing-activity
        && AppState.show-progress && AppState.media.has-timeline;
    property <bool> hovering: AppState.pointer-inside && !AppState.expanded;
    property <length> target-width: AppState.expanded ? AppState.expanded-width
        : root.showing-activity ? root.activity-width
        : (AppState.launcher-enabled && AppState.launcher-active) ? max(AppState.compact-width + 50px, 230px)
        : root.media-mode ? AppState.compact-width + 58px + (root.hovering ? 37px : 0px)
        : AppState.compact-width;
    property <length> target-height: AppState.expanded ? root.expanded-height
        : root.showing-activity ? Theme.activity-height
        : Theme.compact-height;
    // Where the island settles: centred, or, beside the tasks, at the left of the pair.
    property <length> target-x: AppState.expanded && root.tasks-box && root.beside ? (root.width - root.pair-width) / 2
        : (root.width - root.target-width - (root.hovering ? 8px : 0)) / 2;
    // Set while the pointer drags the island so that the release is not a click.
    property <bool> dragging: false;
    // Accumulates smooth trackpad wheel deltas before advancing the compact launcher.
    property <length> launcher-wheel: 0px;

    // The outlines of the island and the tasks box, read by the application after each
    // frame to shape the live blur beneath them. The body follows the auto-hide slide so
    // the blur lifts away with the island instead of being left behind at the top edge.
    out property <length> body-x: island.x;
    out property <length> body-y: keys.y + island.y;
    out property <length> body-width: island.width;
    out property <length> body-height: island.height;
    out property <length> body-radius: island.border-radius;
    out property <float> body-opacity: keys.opacity;
    out property <bool> tasks-shown: AppState.expanded && root.tasks-box;
    property <float> tasks-fade: root.tasks-shown ? 1.0 : 0.0;
    animate tasks-fade {
        duration: root.tasks-shown ? Theme.fade-duration : 0ms;
        delay: root.tasks-shown ? Theme.fade-duration : 0ms;
    }
    out property <length> tasks-x: root.beside ? (root.width - root.pair-width) / 2 + AppState.expanded-width + root.gap
        : (root.width - root.tasks-width) / 2;
    out property <length> tasks-y: keys.y + (root.beside ? 0px : island.height + root.gap);
    out property <length> tasks-box-width: root.tasks-width;
    out property <length> tasks-box-height: root.tasks-height;
    out property <length> tasks-radius: Theme.expanded-radius;
    out property <float> tasks-opacity: keys.opacity * root.tasks-fade;

    property <bool> expanded: AppState.expanded;
    property <bool> modal-input: ClipboardState.editing || TasksState.editing || TasksState.adding || ControlsState.wifi-password-for != "";
    property <bool> tasks-filter-open: false;
    property <bool> tasks-archive-busy: false;
    property <bool> clipboard-menu-open: false;
    property <bool> clipboard-search-focused: false;

    changed modal-input => {
        if !self.modal-input && self.expanded {
            keys.focus();
        }
    }

    changed expanded => {
        if self.expanded {
            keys.focus();
        } else {
            AppState.page = Page.dashboard;
            root.tasks-filter-open = false;
            root.tasks-archive-busy = false;
            root.clipboard-menu-open = false;
            root.clipboard-search-focused = false;
            ControlsState.wifi-password = "";
            ControlsState.wifi-password-for = "";
            ControlsState.input-busy = false;
        }
    }

    // How far the island lifts above the top edge when auto-hidden, enough to clear the
    // compact or activity pill plus its shadow margin.
    property <length> tuck-shift: max(Theme.compact-height, Theme.activity-height) + 2 * Theme.margin + 24px;

    // Keyboard handling for the whole island. Keys that a field or row inside does not
    // use arrive here. The whole island slides up and fades out when auto-hidden.
    keys := FocusScope {
        y: AppState.tucked ? -root.tuck-shift : 0px;
        opacity: AppState.tucked ? 0 : 1;
        animate y { duration: Theme.resize-duration; easing: cubic-bezier(0.32, 0.72, 0, 1); }
        animate opacity { duration: Theme.fade-duration; }

        key-pressed(event) => {
            if !AppState.expanded {
                return reject;
            }
            if event.text == Key.Escape {
                if ControlsState.wifi-password-for != "" {
                    ControlsState.wifi-password = "";
                    ControlsState.wifi-password-for = "";
                    ControlsState.input-busy = false;
                    ControlsActions.busy(false);
                    keys.focus();
                } else if root.clipboard-panel && ClipboardState.editing {
                    ClipboardState.editing = false;
                    keys.focus();
                } else if root.clipboard-panel && root.clipboard-menu-open {
                    root.clipboard-menu-open = false;
                } else if TasksState.editing {
                    TasksState.editing = false;
                    keys.focus();
                } else if TasksState.adding {
                    TasksState.adding = false;
                    keys.focus();
                } else if !root.clipboard-panel && root.tasks-filter-open {
                    root.tasks-filter-open = false;
                } else {
                    AppActions.collapse();
                }
                return accept;
            }
            // The clipboard shelf: arrows choose an entry, Enter copies it and closes the
            // island, Delete removes it, Ctrl+F or / searches. Skip when typing into another panel.
            if root.tasks-box && root.clipboard-panel && !ClipboardState.editing && !ClipboardState.show-intro {
                if event.modifiers.control && (event.text == "f" || event.text == "F") {
                    ClipboardState.search-focus += 1;
                    return accept;
                }
                if (AppState.page == Page.dashboard || root.clipboard-search-focused)
                    && !TasksState.adding && !TasksState.editing && !root.tasks-archive-busy && !ControlsState.input-busy
                {
                    if event.text == Key.DownArrow || event.text == Key.UpArrow {
                        ClipboardActions.move-selection(event.text == Key.DownArrow ? 1 : -1);
                        return accept;
                    }
                    if event.text == Key.Return {
                        ClipboardActions.copy-selected();
                        return accept;
                    }
                    if event.text == Key.Delete {
                        ClipboardActions.delete-selected();
                        return accept;
                    }
                    if event.text == "/" {
                        ClipboardState.search-focus += 1;
                        return accept;
                    }
                }
            }
            if root.tasks-box && !root.clipboard-panel && !TasksState.editing && !TasksState.adding
                && !root.tasks-archive-busy && !ControlsState.input-busy && AppState.page == Page.dashboard
                && (event.text == "n" || event.text == "N") && !event.modifiers.control && !event.modifiers.alt
            {
                TasksState.adding = true;
                return accept;
            }
            reject
        }

        Shadow {
            x: island.x;
            y: island.y;
            width: island.width;
            height: island.height;
            radius: island.border-radius;
        }

        island := Rectangle {
            x: root.target-x;
            y: 0;
            width: root.target-width + (root.hovering ? 8px : 0);
            height: root.target-height + (root.hovering ? 2px : 0);
            // Bound to the target height rather than the animated height, so the corners
            // animate smoothly between the pill and the panel shape.
            border-radius: AppState.expanded ? Theme.expanded-radius
                : root.showing-activity ? 26px
                : (Theme.compact-height + (root.hovering ? 2px : 0)) / 2;
            property <color> wash: Theme.wash;
            animate wash { duration: Theme.ambient-duration; easing: ease-in-out; }
            property <bool> washed: AppState.expanded && root.media-mode && AppState.has-artwork && Theme.ambient > 0;
            property <color> base: root.hovering ? Theme.surface-hover : Theme.surface;
            animate base { duration: Theme.hover-duration; }
            // The artwork colour tints the expanded surface itself. The software renderer
            // draws gradients and clipped children as rectangles, so a gradient overlay would
            // show outside the rounded corners; a solid tint keeps the shape exact.
            background: self.washed ? self.base.mix(self.wash, 1 - 0.16 * Theme.ambient) : self.base;
            animate background { duration: Theme.ambient-duration; easing: ease-in-out; }
            // On glass appearances GlassRim draws the lit rounded edge when UI hue gradient is active;
            // keep the subtle 1 px outline when hue gradient is zero.
            border-width: AppState.center-snapped ? 2px : (Theme.reflections && Theme.hue-gradient > 0) ? 0px : 1px;
            border-color: AppState.center-snapped ? Theme.accent : Theme.border;
            animate border-color { duration: Theme.fade-duration; }
            clip: true;
            animate x, width, height, border-radius { duration: Theme.resize-duration; easing: cubic-bezier(0.32, 0.72, 0, 1); }

            if Theme.hue-gradient > 0 && Theme.sheen.alpha > 0 : GlassSheen {
                width: parent.width;
                height: parent.height;
                radius: island.border-radius;
                strength: Theme.hue-gradient;
            }

            // The lit edges: soft light gathering along the top and bottom and easing off
            // inward and around the corners. Drawn beneath the content so text stays crisp.
            if Theme.hue-gradient > 0 && Theme.rim.alpha > 0 : GlassRim {
                width: parent.width;
                height: parent.height;
                radius: island.border-radius;
                strength: Theme.hue-gradient;
            }

            if Theme.hue-gradient > 0 && Theme.lower-rim.alpha > 0 : GlassRim {
                width: parent.width;
                height: parent.height;
                radius: island.border-radius;
                lower: true;
                rim: Theme.lower-rim;
                strength: Theme.hue-gradient;
            }

            touch := TouchArea {
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        root.dragging = false;
                        if event.button == PointerEventButton.middle && !AppState.expanded && AppState.launcher-enabled {
                            AppActions.toggle-launcher();
                        }
                    }
                }
                scroll-event(event) => {
                    if !AppState.expanded && AppState.launcher-enabled {
                        if (event.delta-y > 0px && root.launcher-wheel < 0px)
                            || (event.delta-y < 0px && root.launcher-wheel > 0px) {
                            root.launcher-wheel = 0px;
                        }
                        root.launcher-wheel += event.delta-y;
                        if abs(root.launcher-wheel) >= 45px {
                            AppActions.scroll-launcher(root.launcher-wheel > 0px ? -1 : 1);
                            root.launcher-wheel = 0px;
                        }
                        return accept;
                    }
                    return reject;
                }
                moved => {
                    if self.pressed && !root.dragging && AppState.allow-drag && !AppState.expanded
                        && (abs(self.mouse-x - self.pressed-x) > 4px || abs(self.mouse-y - self.pressed-y) > 4px) {
                        root.dragging = true;
                        AppActions.start-drag();
                    }
                }
                clicked => {
                    if root.dragging {
                        root.dragging = false;
                    } else if AppState.launcher-enabled && AppState.launcher-active {
                        AppActions.toggle-launcher();
                    } else {
                        AppActions.toggle-expanded();
                    }
                }
            }

            CompactView {
                x: 0;
                y: 0;
                width: parent.width;
                height: AppState.expanded ? Theme.compact-height : parent.height;
                visible: self.opacity > 0;
                media-mode: root.media-mode;
                hovered: root.hovering && !root.showing-activity;
                opacity: AppState.expanded || root.showing-activity ? 0 : 1;
                animate opacity { duration: Theme.fade-duration; }
            }

            Rectangle {
                x: 10px;
                y: parent.height - 4px;
                width: max(0px, parent.width - 20px) * clamp(AppState.progress, 0, 1);
                height: 2px;
                border-radius: 1px;
                background: Theme.accent;
                opacity: root.compact-progress ? 1 : 0;
                animate opacity { duration: Theme.fade-duration; }
                animate background { duration: Theme.ambient-duration; easing: ease-in-out; }
            }

            if root.showing-activity: ActivityView {
                x: 0;
                y: 0;
                width: root.activity-width;
                height: Theme.activity-height;
                opacity: 0;
                animate opacity { duration: Theme.fade-duration; delay: Theme.fade-duration / 2; }
                init => {
                    self.opacity = 1;
                }
            }

            // Created only while expanded, so the collapsed island keeps no hidden content.
            if AppState.expanded : ExpandedView {
                x: 0;
                y: 0;
                width: AppState.expanded-width;
                height: root.expanded-height;
                opacity: 0;
                animate opacity { duration: Theme.fade-duration; delay: Theme.fade-duration / 2; }
                init => {
                    self.opacity = 1;
                }
            }

        }

        // The tasks box, created only while expanded. It fades in beside or below the
        // island as the island opens.
        if root.tasks-shown : Rectangle {
            x: root.tasks-x;
            y: root.tasks-y - keys.y;
            width: root.tasks-width;
            height: root.tasks-height;
            opacity: root.tasks-fade;

            Shadow {
                width: parent.width;
                height: parent.height;
                radius: Theme.expanded-radius;
            }

            Rectangle {
                border-radius: Theme.expanded-radius;
                background: Theme.surface;
                // See the island surface: GlassRim draws the visible edge when UI hue gradient is active.
                border-width: (Theme.reflections && Theme.hue-gradient > 0) ? 0px : 1px;
                border-color: Theme.border;
                clip: true;

                if Theme.hue-gradient > 0 && Theme.sheen.alpha > 0 : GlassSheen {
                    width: parent.width;
                    height: parent.height;
                    radius: Theme.expanded-radius;
                    strength: Theme.hue-gradient;
                }

                if Theme.hue-gradient > 0 && Theme.rim.alpha > 0 : GlassRim {
                    width: parent.width;
                    height: parent.height;
                    radius: Theme.expanded-radius;
                    strength: Theme.hue-gradient;
                }

                if Theme.hue-gradient > 0 && Theme.lower-rim.alpha > 0 : GlassRim {
                    width: parent.width;
                    height: parent.height;
                    radius: Theme.expanded-radius;
                    lower: true;
                    rim: Theme.lower-rim;
                    strength: Theme.hue-gradient;
                }

                if !root.clipboard-panel : TasksView {
                    width: parent.width;
                    height: parent.height;
                    filter-open <=> root.tasks-filter-open;
                    archive-searching <=> root.tasks-archive-busy;
                }

                if root.clipboard-panel : ClipboardView {
                    width: parent.width;
                    height: parent.height;
                    menu-open <=> root.clipboard-menu-open;
                    searching-changed(focused) => { root.clipboard-search-focused = focused; }
                }
            }
        }
    }
}
