import { Theme } from "theme.slint";
import { Page } from "types.slint";
import { AppState, AppActions } from "state.slint";
import { CompactView } from "compact.slint";
import { ExpandedView } from "expanded.slint";

export component Island inherits Window {
    title: "Lilt";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: Theme.font;

    // The window covers the largest state plus room for the shadow. Transparent pixels
    // are click-through, so the unused area never blocks other windows.
    width: max(AppState.expanded-width, 340px) + 2 * Theme.margin;
    height: 250px + 2 * Theme.margin;

    out property <length> expanded-height: Theme.padding * 2 + 60px;

    property <bool> hovering: touch.has-hover && !AppState.expanded;
    property <length> target-width: AppState.expanded ? AppState.expanded-width : AppState.compact-width;
    property <length> target-height: AppState.expanded ? root.expanded-height : Theme.compact-height;
    // Set while the pointer drags the island so that the release is not a click.
    property <bool> dragging: false;

    property <bool> expanded: AppState.expanded;
    changed expanded => {
        if self.expanded {
            keys.focus();
        } else {
            AppState.page = Page.dashboard;
        }
    }

    // Soft depth. The software renderer does not draw drop shadows, so two translucent
    // layers approximate one.
    Rectangle {
        x: island.x - 3px;
        y: island.y + 1px;
        width: island.width + 6px;
        height: island.height + 6px;
        border-radius: island.border-radius + 3px;
        background: Theme.shadow-far;
    }

    Rectangle {
        x: island.x - 1px;
        y: island.y + 1px;
        width: island.width + 2px;
        height: island.height + 2px;
        border-radius: island.border-radius + 1px;
        background: Theme.shadow-near;
    }

    island := Rectangle {
        x: (root.width - self.width) / 2;
        y: 0;
        width: root.target-width + (root.hovering ? 8px : 0);
        height: root.target-height + (root.hovering ? 2px : 0);
        // Bound to the target height rather than the animated height, so the corners
        // animate smoothly between the pill and the panel shape.
        border-radius: AppState.expanded ? Theme.expanded-radius : (Theme.compact-height + (root.hovering ? 2px : 0)) / 2;
        background: root.hovering ? Theme.surface-hover : Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;
        animate width, height, border-radius { duration: Theme.resize-duration; easing: cubic-bezier(0.32, 0.72, 0, 1); }
        animate background { duration: Theme.hover-duration; }

        touch := TouchArea {
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    root.dragging = false;
                }
            }
            moved => {
                if self.pressed && !root.dragging && AppState.allow-drag && !AppState.expanded
                    && (abs(self.mouse-x - self.pressed-x) > 4px || abs(self.mouse-y - self.pressed-y) > 4px) {
                    root.dragging = true;
                    AppActions.start-drag();
                }
            }
            clicked => {
                if root.dragging {
                    root.dragging = false;
                } else {
                    AppActions.toggle-expanded();
                }
            }
        }

        CompactView {
            x: 0;
            y: 0;
            width: parent.width;
            height: AppState.expanded ? Theme.compact-height : parent.height;
            opacity: AppState.expanded ? 0 : 1;
            animate opacity { duration: Theme.fade-duration; }
        }

        // Created only while expanded, so the collapsed island keeps no hidden content.
        if AppState.expanded : ExpandedView {
            x: 0;
            y: 0;
            width: AppState.expanded-width;
            height: root.expanded-height;
            opacity: 0;
            animate opacity { duration: Theme.fade-duration; delay: Theme.fade-duration / 2; }
            init => {
                self.opacity = 1;
            }
        }
    }

    keys := FocusScope {
        width: 0;
        height: 0;
        key-pressed(event) => {
            if event.text == Key.Escape && AppState.expanded {
                AppActions.collapse();
                return accept;
            }
            reject
        }
    }
}
