import { MarqueeText } from "components/marquee.slint";
import { Theme } from "theme.slint";
import { MediaAvailability } from "types.slint";
import { AppState, AppActions } from "state.slint";
import { Icon, Icons } from "components/icon.slint";
import { IconButton, ProgressBar } from "components/controls.slint";
import { ArtworkTile } from "artwork.slint";

component PlayButton inherits Rectangle {
    in property <bool> playing;
    in property <bool> enabled;
    callback clicked();
    width: 34px;
    height: 34px;
    border-radius: 17px;
    background: !root.enabled ? Theme.tile-hover : touch.pressed ? #d6d6da : touch.has-hover ? #ffffff : Theme.text;
    animate background { duration: Theme.hover-duration; }
    accessible-role: button;
    accessible-label: root.playing ? "Pause" : "Play";

    Icon {
        // The play triangle is optically centred slightly right of the geometric centre.
        x: (parent.width - self.width) / 2 + (root.playing ? 0 : 1px);
        data: root.playing ? Icons.pause : Icons.play;
        filled: true;
        size: 14px;
        color: root.enabled ? Theme.text-on-light : Theme.text-tertiary;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// Now-playing view with transport controls, or an explanation when nothing plays.
export component MediaPlayer inherits Rectangle {
    property <bool> active: AppState.media.availability == MediaAvailability.active
        || (AppState.media-grace && AppState.media.title != "");
    property <color> glow: Theme.glow;
    animate glow { duration: Theme.ambient-duration; easing: ease-in-out; }

    // A restrained accent behind the artwork. Static: it only changes when the artwork
    // does, through the colour animation above.
    if root.active && AppState.show-artwork && AppState.has-artwork && Theme.ambient > 0: Rectangle {
        x: -40px;
        y: (root.height - self.height) / 2;
        width: 152px;
        height: 152px;
        background: @radial-gradient(circle, root.glow.with-alpha(0.45 * Theme.ambient) 0%, root.glow.with-alpha(0.14 * Theme.ambient) 40%, root.glow.with-alpha(0) 70%);
    }

    HorizontalLayout {
        spacing: 14px;

        if AppState.show-artwork: Rectangle {
            width: 96px;
            height: 100px;
            ArtworkTile { y: 2px; size: 96px; }
        }

        VerticalLayout {
            alignment: center;
            spacing: 4px;

            HorizontalLayout {
                height: 34px;
                spacing: 4px;

                MarqueeText {
                    height: 34px;
                    live: AppState.expanded;
                    text: !root.active
                        ? (AppState.media.availability == MediaAvailability.idle ? "Nothing playing" : "Media controls unavailable")
                        : AppState.media.title == "" ? "Unknown title" : AppState.media.title;
                    tint: Theme.text;
                    // A track title is content, in the body face; "Nothing playing" is
                    // a heading.
                    font-family: root.active ? Theme.font : Theme.title-font;
                    font-size: root.active ? Theme.font-lg : Theme.font-lg * Theme.title-scale;
                    font-weight: root.active ? 700 : Theme.title-weight;
                }

                if root.active: IconButton {
                    height: 34px;
                    icon: Icons.previous;
                    icon-size: 14px;
                    filled: true;
                    enabled: AppState.media.can-previous;
                    tooltip: "Previous track";
                    clicked => {
                        AppActions.previous-track();
                    }
                }

                if root.active: PlayButton {
                    playing: AppState.media.playing;
                    enabled: AppState.media.can-play-pause;
                    clicked => {
                        AppActions.toggle-play();
                    }
                }

                if root.active: IconButton {
                    height: 34px;
                    icon: Icons.next;
                    icon-size: 14px;
                    filled: true;
                    enabled: AppState.media.can-next;
                    tooltip: "Next track";
                    clicked => {
                        AppActions.next-track();
                    }
                }
            }

            HorizontalLayout {
                height: 20px;
                spacing: 6px;

                Text {
                    horizontal-stretch: 1;
                    height: 20px;
                    vertical-alignment: center;
                    text: !root.active
                        ? (AppState.media.availability == MediaAvailability.idle
                            ? "Play something in Spotify, a browser or any media app."
                            : "Windows did not allow access to media sessions.")
                        : AppState.media.artist == "" ? AppState.media.source : AppState.media.artist + "  ·  " + AppState.media.source;
                    color: Theme.text-secondary;
                    font-size: Theme.font-sm;
                    font-weight: 600;
                    overflow: elide;
                }

                // Several apps expose sessions: let the user pick which one to follow.
                if root.active && AppState.media.session-count > 1: TouchArea {
                    width: 18px;
                    height: 20px;
                    clicked => {
                        AppActions.cycle-source();
                    }

                    Icon {
                        y: (parent.height - self.height) / 2;
                        data: Icons.switch;
                        size: 13px;
                        color: parent.has-hover ? Theme.text : Theme.text-tertiary;
                    }
                }
            }

            if root.active && AppState.show-progress && AppState.media.has-timeline: VerticalLayout {
                height: 30px;
                spacing: 0px;

                ProgressBar {
                    value: AppState.progress;
                    seekable: AppState.media.can-seek;
                    seek(fraction) => {
                        AppActions.seek(fraction);
                    }
                }

                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: AppState.position-text;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-xs;
                    }

                    Text {
                        text: AppState.duration-text;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-xs;
                    }
                }
            }
        }
    }
}
